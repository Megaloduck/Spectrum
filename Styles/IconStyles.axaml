<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="using:Material.Icons.Avalonia">

  <!-- ===================== Icon baseline ===================== -->
  <!-- Material Icons is the workhorse for chrome and actions. One default size
       (18) and a secondary foreground keep glyphs quieter than their labels;
       local Width/Height and Foreground still win where a view needs them. -->

  <Style Selector="materialIcons|MaterialIcon">
    <Setter Property="Width" Value="18"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>

  <!-- Dense icon pair inside a chip or a section header. -->
  <Style Selector="materialIcons|MaterialIcon.small">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
  </Style>

</Styles>
