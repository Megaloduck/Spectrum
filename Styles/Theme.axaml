<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:anim="using:Avalonia.Animation">

  <!-- ===================== Design tokens ===================== -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CanvasBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F5F5F5"/>
          <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EFEFEF"/>
          <SolidColorBrush x:Key="SurfacePressedBrush" Color="#E0E0E0"/>
          <SolidColorBrush x:Key="OutlineBrush" Color="#000000"/>
          <!-- Color twin of OutlineBrush: SolidColorBrush.Color can only bind a
               Color resource, not the brush itself. -->
          <Color x:Key="OutlineColor">#000000</Color>
          <SolidColorBrush x:Key="HairlineBrush" Color="#E2E2E2"/>
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#000000"/>
          <SolidColorBrush x:Key="TextMutedBrush" Color="#6B6B6B"/>

          <!-- Fluent's own text-field state colors, pinned to our surfaces so a
               focused / hovered field never flips to a hard-coded light fill. -->
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#000000"/>
          <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#000000"/>
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#EFEFEF"/>
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#E0E0E0"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CanvasBrush" Color="#121212"/>
          <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1B1B"/>
          <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#242424"/>
          <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2C2C2C"/>
          <SolidColorBrush x:Key="SurfacePressedBrush" Color="#383838"/>
          <SolidColorBrush x:Key="OutlineBrush" Color="#FFFFFF"/>
          <Color x:Key="OutlineColor">#FFFFFF</Color>
          <SolidColorBrush x:Key="HairlineBrush" Color="#3A3A3A"/>
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F2"/>
          <SolidColorBrush x:Key="TextMutedBrush" Color="#A0A0A0"/>

          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1B1B1B"/>
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1B1B1B"/>
          <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F2F2F2"/>
          <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F2F2F2"/>
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#2C2C2C"/>
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#383838"/>
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>

      <!-- =====================================================================
           Global tokens
           DangerBrush is deliberately NOT a theme dictionary entry: it is a
           hard-coded foreground tint used only inside controlled warning /
           confirmation surfaces (library delete button, Settings reset
           panel, ColorPickerDialog input feedback). Giving it a token lets
           grep verify the red #E5484D no longer leaks into chrome.
           AccentBrush defaults to teal (#0F766E) and is what SettingsService
           .ApplyAccent swaps at runtime. Focus rings on text fields and
           combo boxes follow it; the BoxShadow rings on buttons cannot bind
           a brush, so they stay teal.
           ===================================================================== -->
      <SolidColorBrush x:Key="DangerBrush" Color="#E5484D"/>

      <SolidColorBrush x:Key="AccentBrush" Color="#0F766E"/>

      <!-- Pass/fail verdict fill for contrast role rows — the one "good state"
           color, themed so it stays legible on both canvases. -->
      <SolidColorBrush x:Key="SuccessBrush" Color="#15803D"/>

      <!-- Card chrome — quieter than the panel outline so color stays the event. -->
      <SolidColorBrush x:Key="CardStrokeBrush" Color="{DynamicResource OutlineColor}">
        <SolidColorBrush.Opacity>0.55</SolidColorBrush.Opacity>
      </SolidColorBrush>

      <SolidColorBrush x:Key="CardStrokeActiveBrush" Color="{DynamicResource OutlineColor}"/>

      <CornerRadius x:Key="CardRadius">14</CornerRadius>
      <CornerRadius x:Key="SoftRadius">10</CornerRadius>
      <CornerRadius x:Key="PillRadius">999</CornerRadius>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ===================== Density ===================== -->
  <Style Selector="Window.compact">
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <Style Selector="Window.compact Grid#RootGrid">
    <Setter Property="Margin" Value="10"/>
  </Style>

  <!-- ===================== Base ===================== -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}"/>
    <Setter Property="FontFamily" Value="Inter"/>
  </Style>

  <!-- Body size: the default for anything not carrying a type class. Declared
       here, before the typography classes, so .caption / .display / .label
       always win over it. -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <!-- Density: compact shrinks unstyled body text. Declared after the base
       but before the type classes, so the scale itself still wins. -->
  <Style Selector="Window.compact TextBlock">
    <Setter Property="FontSize" Value="12"/>
  </Style>


  <!-- ===================== Typography ===================== -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{DynamicResource Cabazon}"/>
    <Setter Property="FontSize" Value="34"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="LetterSpacing" Value="0"/>
  </Style>

  <Style Selector="TextBlock.display.small">
    <Setter Property="FontSize" Value="24"/>
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="LetterSpacing" Value="-0.3"/>
  </Style>

  <Style Selector="TextBlock.sectionHeader">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LetterSpacing" Value="-0.1"/>
  </Style>

  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="LetterSpacing" Value="0.8"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LetterSpacing" Value="0.6"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>

  <Style Selector="TextBlock.label.subtle">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>

  <!-- caption / subtitle: the muted voice of the scale. Both were part of the
       original type system and are still used across the shell and dialogs. -->
  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>

  <!-- mono: every hex, ratio, ΔE and code string reads in Fragment Mono. The
       resource is the bundled font; the setter takes the DynamicResource as its
       whole value so the family actually resolves at runtime. -->
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource FragmentMono}"/>
  </Style>

  <!-- Density: display type also shrinks under compact. Declared last so it
       beats the .display class above. -->
  <Style Selector="Window.compact TextBlock.display">
    <Setter Property="FontSize" Value="26"/>
  </Style>

  <!-- ===================== Panels / cards ===================== -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="CornerRadius" Value="18"/>
  </Style>

  <!-- ===================== Buttons ===================== -->
  <!-- Reference-design buttons are flat and outlined: the action is the label,
       not a filled surface. This keeps the palette the visual event. -->
  <Style Selector="Button, Button.primary">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
    <Setter Property="BorderThickness" Value="1.2"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>

  <!-- Ghost button: no stroke, used for dense chrome and overlay actions. -->
  <Style Selector="Button.ghost.small">
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
  </Style>

  <!-- Pressed used to fill with OutlineBrush (black in light theme), which made
       the label black-on-black while the mouse was down. A slightly deeper
       surface keeps the text readable in both themes. -->
  <Style Selector="Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
  </Style>

  <Style Selector="Button:focus-visible /template/ ContentPresenter">
    <!-- BoxShadow is applied to the ContentPresenter; it doesn't move the button. -->
    <Setter Property="BoxShadow" Value="0 0 0 2 #0F766E, inset 0 0 0 1 #FFFFFF"/>
  </Style>

  <Style Selector="Button:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.4"/>
  </Style>

  <!-- Ghost pill buttons -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <Style Selector="Button.pill">
    <Setter Property="CornerRadius" Value="20"/>
  </Style>

  <!-- Small overlay icon/text buttons on top of a colored swatch bar.
       Foreground is bound per-item (see ForegroundBrush) so text/icons stay
       readable against whatever color the bar is. -->
  <Style Selector="Button.iconOnly">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="4,2"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
  </Style>

  <Style Selector="Button.iconOnly:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#22000000"/>
  </Style>

  <Style Selector="Button.iconOnly:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#44000000"/>
  </Style>

  <Style Selector="Button.iconOnly:focus-visible /template/ ContentPresenter">
    <Setter Property="BoxShadow" Value="0 0 0 2 #0F766E"/>
  </Style>

  <Style Selector="ToggleButton.iconOnly">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="4,2"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="Opacity" Value="0.6"/>
  </Style>

  <Style Selector="ToggleButton.iconOnly:checked">
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="ToggleButton.iconOnly:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#22000000"/>
  </Style>

  <Style Selector="ToggleButton.iconOnly:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#44000000"/>
  </Style>

  <Style Selector="ToggleButton.iconOnly:focus-visible /template/ ContentPresenter">
    <Setter Property="BoxShadow" Value="0 0 0 2 #0F766E"/>
  </Style>

  <!-- ===================== Workspace nav / app bar ===================== -->
  <Style Selector="Button.wsTab">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="16,7"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
  </Style>

  <Style Selector="Button.wsTab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
  </Style>

  <Style Selector="Button.wsTab:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
  </Style>

  <Style Selector="Button.wsTab:focus-visible /template/ ContentPresenter">
    <Setter Property="BoxShadow" Value="0 0 0 2 #0F766E"/>
  </Style>

  <Style Selector="Button.wsTab.active">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- ===================== Swatch selection + menu items ===================== -->
  <!-- Every swatch card reserves a 3px transparent border so selecting one only
       recolors the ring — nothing in the card shifts. -->
  <Style Selector="Border.swatchCard">
    <Setter Property="BorderThickness" Value="3"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>

  <Style Selector="Border.swatchCard.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeActiveBrush}"/>
  </Style>

  <!-- ===================== Cards ===================== -->
  <!-- A card is a soft raised surface with a faint outline. Color-based cards
       rely on the swatch itself for identity, so the chrome stays quiet. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}"/>
  </Style>

  <!-- Raised action card, for panels that want a stronger surface. -->
  <Style Selector="Border.card.raised">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
  </Style>

  <!-- Docked workspace panels reuse the card surface but keep a softer radius. -->
  <Style Selector="Border.card.dock">
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadius}"/>
  </Style>

  <!-- Text rows inside the swatch "more" flyout. -->
  <Style Selector="Button.menuItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="Normal"/>
  </Style>

  <!-- ===================== Swatch cards + rails ===================== -->
  <!-- Every swatch card reserves a transparent 3px border so selecting one only
       recolors the ring — nothing in the card shifts. -->
  <Style Selector="Border.swatchCard StackPanel.swatchRail">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Transitions">
      <Transitions>
        <anim:DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
      </Transitions>
    </Setter>
  </Style>

  <!-- The action rail shows on hover, while the card is selected, and while
       keyboard focus is inside it — so it is reachable without a mouse. -->
  <Style Selector="Border.swatchCard:pointerover StackPanel.swatchRail">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="IsHitTestVisible" Value="True"/>
  </Style>

  <Style Selector="Border.swatchCard.selected StackPanel.swatchRail">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="IsHitTestVisible" Value="True"/>
  </Style>

  <Style Selector="Border.swatchCard:focus-within StackPanel.swatchRail">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="IsHitTestVisible" Value="True"/>
  </Style>

  <Style Selector="ListBox.paletteList ListBoxItem Button.paletteRail">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Transitions">
      <Transitions>
        <anim:DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ListBox.paletteList ListBoxItem:pointerover Button.paletteRail">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="IsHitTestVisible" Value="True"/>
  </Style>

  <Style Selector="TextBox.swatchName">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <!-- ===================== Inputs ===================== -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
    <Setter Property="BorderThickness" Value="1.3"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>

  <Style Selector="TextBox:focus">
    <!-- Follows the accent setting. The fill stays on the theme surface (it used
         to be a hard-coded #FFFFFF, which gave light text on white in dark mode). -->
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
    <Setter Property="BorderThickness" Value="1.3"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="10,8"/>
  </Style>

  <Style Selector="ComboBox:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>

  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource HairlineBrush}"/>
    <Setter Property="Height" Value="1"/>
    <Setter Property="Margin" Value="0,4"/>
  </Style>

  <!-- ===================== Hierarchy helpers ===================== -->
  <Style Selector="StackPanel.hierarchyRow">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Grid rows with a label/value split are defined inline per panel —
       there is no single Grid.ColumnDefinitions style setter. -->

  <!-- ===================== Breadcrumb ===================== -->
  <Style Selector="StackPanel.breadcrumb">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="Spacing" Value="6"/>
  </Style>

  <Style Selector="TextBlock.breadcrumb">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>

  <Style Selector="TextBlock.breadcrumb.current">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- ===================== Sliders ===================== -->
  <Style Selector="Slider:horizontal">
    <Setter Property="Height" Value="44"/>
    <!-- Hide the default slider track -->
    <Style Selector="^ Track RepeatButton">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </Style>

  <!-- CUSTOM THUMB -->
  <Style Selector="Slider:horizontal /template/ Thumb">
    <Setter Property="Width" Value="5"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
</Styles>
