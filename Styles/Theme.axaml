<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===================== Design tokens ===================== -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CanvasBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F5F5F5"/>
          <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EFEFEF"/>
          <SolidColorBrush x:Key="OutlineBrush" Color="#000000"/>
          <SolidColorBrush x:Key="HairlineBrush" Color="#E2E2E2"/>
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#000000"/>
          <SolidColorBrush x:Key="TextMutedBrush" Color="#6B6B6B"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CanvasBrush" Color="#121212"/>
          <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1B1B"/>
          <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#242424"/>
          <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2C2C2C"/>
          <SolidColorBrush x:Key="OutlineBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="HairlineBrush" Color="#3A3A3A"/>
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F2"/>
          <SolidColorBrush x:Key="TextMutedBrush" Color="#A0A0A0"/>
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ===================== Base ===================== -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}"/>
    <Setter Property="FontFamily" Value="Inter"/>
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>



  <!-- ===================== Typography ===================== -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="30"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="LetterSpacing" Value="-0.5"/>
  </Style>

  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>

  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="LetterSpacing" Value="0.8"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono,JetBrains Mono,Consolas,Menlo,Courier New,monospace"/>
  </Style>

  <!-- ===================== Panels / cards ===================== -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="CornerRadius" Value="18"/>
  </Style>

  <!-- ===================== Buttons ===================== -->
  <!-- Every button in the reference design is the same flat white /
       black-outline look — no filled "primary" style — so Button and
       Button.primary render identically. Keeping both classes means
       existing bindings that reference Classes="primary" don't need
       to change. -->
  <Style Selector="Button, Button.primary">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
    <Setter Property="BorderThickness" Value="1.3"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
  </Style>

  <Style Selector="Button:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.4"/>
  </Style>

  <!-- Ghost pill buttons -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <Style Selector="Button.pill">
    <Setter Property="CornerRadius" Value="20"/>
  </Style>

  <!-- Small overlay icon/text buttons on top of a colored swatch bar.
       Foreground is bound per-item (see ForegroundBrush) so text/icons
       stay readable against whatever color the bar is. -->
  <Style Selector="Button.iconOnly">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="4,2"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
  </Style>

  <Style Selector="Button.iconOnly:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#22000000"/>
  </Style>

  <Style Selector="ToggleButton.iconOnly">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="4,2"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="Opacity" Value="0.6"/>
  </Style>

  <Style Selector="ToggleButton.iconOnly:checked">
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="ToggleButton.iconOnly:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#22000000"/>
  </Style>

  <!-- Borderless inline name field on a swatch card -->
  <Style Selector="TextBox.swatchName">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <!-- ===================== Inputs ===================== -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
    <Setter Property="BorderThickness" Value="1.3"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
    <Setter Property="BorderThickness" Value="1.3"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="10,8"/>
  </Style>

  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource HairlineBrush}"/>
    <Setter Property="Height" Value="1"/>
    <Setter Property="Margin" Value="0,4"/>
  </Style>

  <!-- ===================== Sliders ===================== -->
  <!-- Background carries the always-visible gradient track (bound per-slider
       from the ViewModel, e.g. HueTrackBrush). Foreground is the "filled"
       portion Avalonia normally draws up to the thumb — set to transparent
       so the full gradient reads uniformly, like the reference design,
       instead of looking like a progress bar. -->


    
    <!-- Your custom slider style -->
    <Style Selector="Slider:horizontal">
        <!-- Set a consistent height for all sliders -->
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="Transparent"/>
        
        <!-- Style the track background -->
        <Style Selector="^ Track">
            <Style Selector="^ RepeatButton Border">
                <Setter Property="Height" Value="8" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="#2D2D2D" />
            </Style>
        </Style>
        
        <!-- Style the filled portion (allows your Background binding to work) -->
        <Style Selector="^ Track">
            <Style Selector="^ RepeatButton#PART_DecreaseButton">
                <!-- This allows the Background binding from your XAML to apply -->
                <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=Slider}}" />
                <Style Selector="^ Border">
                    <Setter Property="Height" Value="8" />
                    <Setter Property="CornerRadius" Value="4" />
                </Style>
            </Style>
        </Style>
        
        <!-- Style the thumb (draggable handle) -->
        <Style Selector="^ Thumb#PART_Thumb">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#888" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="9" />
            
            <!-- Hover effect -->
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#F0F0F0" />
                <Setter Property="BorderBrush" Value="#666" />
            </Style>
            
            <!-- Pressed effect -->
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="#E0E0E0" />
                <Setter Property="BorderBrush" Value="#555" />
            </Style>
        </Style>
    </Style>


</Styles>
