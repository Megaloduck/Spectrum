<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Spectrum.Views.ImageEyedropperWindow"
        Title="Eyedropper — pick from image"
        Width="960" Height="680"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/Spectrum.ico"
        Background="{DynamicResource CanvasBrush}">

    <Grid RowDefinitions="*,Auto">

        <!-- The image; pointer events are handled in code-behind against the
             letterboxed render rect so sampling always matches the pixel you see. -->
        <Border Margin="14" CornerRadius="12" BorderThickness="1.3"
                BorderBrush="{DynamicResource OutlineBrush}" Background="{DynamicResource SurfaceBrush}">
            <Image x:Name="ImageControl"
                   Stretch="Uniform" Margin="10"
                   PointerMoved="OnImagePointerMoved"
                   PointerPressed="OnImagePointerPressed"/>
        </Border>

        <!-- Readout bar -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,16,*,Auto" Margin="16,0,16,14">
            <Border Grid.Column="0" x:Name="SampleSwatch" Width="42" Height="42" CornerRadius="8"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1.3"
                    Background="Transparent" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,0,0">
                <TextBlock x:Name="HexText" Text="#" Classes="mono" FontWeight="Bold" FontSize="15"/>
                <TextBlock x:Name="CoordText" Text="Move over the image" Classes="caption"/>
            </StackPanel>
            <TextBlock Grid.Column="3" Classes="caption" VerticalAlignment="Center"
                       Text="Click a pixel to pick it · Esc cancels"/>
            <TextBlock Grid.Column="4" x:Name="NameText" Classes="caption" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </Grid>

    </Grid>
</Window>
