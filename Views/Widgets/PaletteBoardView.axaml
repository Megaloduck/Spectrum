<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spectrum.ViewModels"
             xmlns:models="using:Spectrum.Models"
             xmlns:converters="using:Spectrum.Converters"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:local="using:Spectrum.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Spectrum.Views.PaletteBoardView"
             x:DataType="vm:MainWindowViewModel">

    <!-- The palette itself: the swatch board and the status strip. Studio,
         Preview and Analyze all show exactly this, so it lives here once and
         each workspace just places it. -->

    <UserControl.Resources>
        <!-- Board card templates for the four view modes (§8 grid/list/compact).
             The mode switch is applied in code-behind (PaletteBoardView.ApplyViewMode).

             Card actions, in order of how often they're used:
               · Lock            always visible
               · Details / Edit / Copy / "…"   fade in on hover, while the card is
                 selected, or while keyboard focus is inside it
               · "…" holds the rest: rename, move, duplicate, remove
             Clicking the hex value copies it. -->

        <!-- Row: the classic Coolors-style full-height card (also reused by Grid mode). -->
        <DataTemplate x:Key="RowCardTemplate" x:DataType="models:ColorSwatch">
            <Border Classes="swatchCard" Classes.selected="{Binding IsSelected}"
                    Background="{Binding Brush}" CornerRadius="12" Margin="5" Cursor="Hand" MinHeight="240"
                    AutomationProperties.Name="{Binding Name}"
                    AutomationProperties.AutomationId="{Binding Hex}"
                    PointerPressed="OnSwatchPointerPressed"
                    PointerMoved="OnSwatchPointerMoved"
                    PointerReleased="OnSwatchPointerReleased">
                <ToolTip.Tip>
                    <StackPanel x:DataType="models:ColorSwatch" Width="220" Spacing="3" Margin="6">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="{Binding Hex}" Classes="mono" FontSize="12"/>
                        <TextBlock Text="{Binding RgbLabel}" Classes="mono caption" FontSize="11"/>
                        <TextBlock Text="{Binding HslLabel}" Classes="mono caption" FontSize="11"/>
                        <Separator/>
                        <TextBlock Text="{Binding ContrastLabel}" Classes="caption" FontSize="11"/>
                        <TextBlock Text="{Binding SimulatedNote}" Classes="caption" FontSize="11"/>
                        <TextBlock Text="Drag to reorder · click to select · Del removes"
                                   Classes="caption" FontSize="11"/>
                    </StackPanel>
                </ToolTip.Tip>
                <Grid RowDefinitions="Auto,*,Auto" Margin="11">

                    <!-- Top-right: lock stays put, the rail of actions fades in -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Right" Spacing="6">
                        <ToggleButton Classes="iconOnly"
                                      IsChecked="{Binding IsLocked, Mode=TwoWay}"
                                      ToolTip.Tip="Keep this color when generating">
                            <materialIcons:MaterialIcon
                                Kind="{Binding IsLocked, Converter={x:Static converters:LockIconConverter.Instance}}"
                                Width="14" Height="14" Foreground="{Binding ForegroundBrush}"/>
                        </ToggleButton>

                        <StackPanel Classes="swatchRail" Spacing="6">

                            <!-- Details / zoom (§8) -->
                            <Button Classes="iconOnly" Foreground="{Binding ForegroundBrush}" ToolTip.Tip="Details">
                                <materialIcons:MaterialIcon Kind="Magnify" Width="14" Height="14" Foreground="{Binding ForegroundBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <StackPanel x:DataType="models:ColorSwatch" Width="270" Spacing="7" Margin="6">
                                            <Border Height="120" CornerRadius="10" Background="{Binding Brush}"
                                                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                                            <TextBlock Text="{Binding Hex}" Classes="mono" FontSize="14"/>
                                            <TextBlock Text="{Binding RgbLabel}" Classes="mono caption" FontSize="11"/>
                                            <TextBlock Text="{Binding HslLabel}" Classes="mono caption" FontSize="11"/>
                                            <TextBlock Text="{Binding LabLabel}" Classes="mono caption" FontSize="11"/>
                                            <TextBlock Text="{Binding OklchLabel}" Classes="mono caption" FontSize="11"/>
                                            <Separator/>
                                            <TextBlock Text="{Binding ContrastLabel}" Classes="caption" FontSize="11"/>
                                            <TextBlock Text="{Binding WhiteTextBadge}" Classes="caption" FontSize="11"/>
                                            <TextBlock Text="{Binding BlackTextBadge}" Classes="caption" FontSize="11"/>
                                            <Button Content="Edit color…" HorizontalAlignment="Stretch"
                                                    Command="{Binding EditColorCommand}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <!-- Edit (spectrum picker) -->
                            <Button Classes="iconOnly" Foreground="{Binding ForegroundBrush}"
                                    Command="{Binding EditColorCommand}" CommandParameter="{Binding}"
                                    ToolTip.Tip="Edit color (spectrum picker)">
                                <materialIcons:MaterialIcon Kind="Palette" Width="14" Height="14" Foreground="{Binding ForegroundBrush}"/>
                            </Button>

                            <!-- Copy in the selected format -->
                            <Button Classes="iconOnly" Foreground="{Binding ForegroundBrush}"
                                    Command="{Binding CopyCommand}" CommandParameter="{Binding}"
                                    ToolTip.Tip="Copy in the selected format">
                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" Foreground="{Binding ForegroundBrush}"/>
                            </Button>

                            <!-- More: rename, move, duplicate, remove -->
                            <Button Classes="iconOnly" Foreground="{Binding ForegroundBrush}" ToolTip.Tip="More actions">
                                <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="14" Height="14" Foreground="{Binding ForegroundBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <StackPanel x:DataType="models:ColorSwatch" Width="190" Spacing="2" Margin="4">
                                            <TextBlock Text="RENAME" Classes="eyebrow" Margin="4,0,0,2"/>
                                            <TextBox Text="{Binding Name}" Watermark="Name"/>
                                            <Separator Margin="0,6"/>
                                            <Button Classes="menuItem" Command="{Binding MoveUpCommand}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <materialIcons:MaterialIcon Kind="ArrowLeft" Width="15" Height="15"/>
                                                    <TextBlock Text="Move earlier" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="menuItem" Command="{Binding MoveDownCommand}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <materialIcons:MaterialIcon Kind="ArrowRight" Width="15" Height="15"/>
                                                    <TextBlock Text="Move later" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="menuItem" Command="{Binding DuplicateCommand}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <materialIcons:MaterialIcon Kind="ContentDuplicate" Width="15" Height="15"/>
                                                    <TextBlock Text="Duplicate" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="menuItem" Command="{Binding RemoveCommand}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <materialIcons:MaterialIcon Kind="Close" Width="15" Height="15"
                                                                                Foreground="{DynamicResource DangerBrush}"/>
                                                    <TextBlock Text="Remove" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource DangerBrush}"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                        </StackPanel>
                    </StackPanel>

                    <!-- Name + hex label anchored to the bottom of the bar -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Spacing="3">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                   TextWrapping="Wrap" Foreground="{Binding ForegroundBrush}"/>
                        <TextBlock Text="HEX" FontSize="9" FontWeight="SemiBold" LetterSpacing="1"
                                   Opacity="0.65" Foreground="{Binding ForegroundBrush}"/>

                        <!-- Click the hex to copy it (in the footer's selected format) -->
                        <Button Classes="iconOnly" HorizontalAlignment="Left" Margin="-4,0,0,0"
                                Foreground="{Binding ForegroundBrush}"
                                Command="{Binding CopyCommand}" CommandParameter="{Binding}"
                                ToolTip.Tip="Click to copy">
                            <TextBlock Text="{Binding Hex}" FontWeight="SemiBold" FontSize="14"
                                       Classes="mono" Foreground="{Binding ForegroundBrush}"/>
                        </Button>

                        <TextBlock Text="{Binding ContrastLabel}" FontSize="10" Opacity="0.7"
                                   Margin="0,2,0,0"
                                   Foreground="{Binding ForegroundBrush}"/>
                        <!-- §8 contrast overlay badges -->
                        <TextBlock Text="{Binding WhiteTextBadge}" FontSize="10" Opacity="0.85"
                                   Foreground="{Binding ForegroundBrush}"
                                   IsVisible="{Binding ShowContrastOverlay}"/>
                        <TextBlock Text="{Binding BlackTextBadge}" FontSize="10" Opacity="0.85"
                                   Foreground="{Binding ForegroundBrush}"
                                   IsVisible="{Binding ShowContrastOverlay}"/>
                    </StackPanel>

                </Grid>
            </Border>
        </DataTemplate>

        <!-- Grid: wrapped fixed-size cards, same content as Row. -->
        <DataTemplate x:Key="GridCardTemplate" x:DataType="models:ColorSwatch">
            <Border Width="196" Height="252">
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource RowCardTemplate}"/>
            </Border>
        </DataTemplate>

        <!-- List: one wide row per swatch with its data (§8 list view). -->
        <DataTemplate x:Key="ListCardTemplate" x:DataType="models:ColorSwatch">
            <Border Classes="swatchCard" Classes.selected="{Binding IsSelected}"
                    Background="{Binding Brush}" CornerRadius="12" Margin="5" Height="72" Cursor="Hand"
                    AutomationProperties.Name="{Binding Name}"
                    AutomationProperties.AutomationId="{Binding Hex}"
                    PointerPressed="OnSwatchPointerPressed"
                    PointerMoved="OnSwatchPointerMoved"
                    PointerReleased="OnSwatchPointerReleased">
                <Grid ColumnDefinitions="*,Auto" Margin="13,0">
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                       Foreground="{Binding ForegroundBrush}"/>
                            <TextBlock Text="{Binding Hex}" Classes="mono" FontSize="13"
                                       Foreground="{Binding ForegroundBrush}"/>
                            <TextBlock Text="{Binding RgbLabel}" Classes="mono caption" FontSize="11"
                                       Foreground="{Binding ForegroundBrush}"/>
                            <TextBlock Text="{Binding HslLabel}" Classes="mono caption" FontSize="11"
                                       Foreground="{Binding ForegroundBrush}"/>
                            <TextBlock Text="{Binding ContrastLabel}" FontSize="11"
                                       Foreground="{Binding ForegroundBrush}" Opacity="0.85"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding WhiteTextBadge}" FontSize="10"
                                       Foreground="{Binding ForegroundBrush}"
                                       IsVisible="{Binding ShowContrastOverlay}"/>
                            <TextBlock Text="{Binding BlackTextBadge}" FontSize="10"
                                       Foreground="{Binding ForegroundBrush}"
                                       IsVisible="{Binding ShowContrastOverlay}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ToggleButton Classes="iconOnly" IsChecked="{Binding IsLocked, Mode=TwoWay}"
                                      ToolTip.Tip="Keep this color when generating">
                            <materialIcons:MaterialIcon
                                Kind="{Binding IsLocked, Converter={x:Static converters:LockIconConverter.Instance}}"
                                Width="14" Height="14" Foreground="{Binding ForegroundBrush}"/>
                        </ToggleButton>
                        <StackPanel Classes="swatchRail" Orientation="Horizontal" Spacing="8">
                            <Button Classes="iconOnly" Foreground="{Binding ForegroundBrush}"
                                    Command="{Binding EditColorCommand}" CommandParameter="{Binding}"
                                    ToolTip.Tip="Edit color (spectrum picker)">
                                <materialIcons:MaterialIcon Kind="Palette" Width="14" Height="14" Foreground="{Binding ForegroundBrush}"/>
                            </Button>
                            <Button Classes="iconOnly" Foreground="{Binding ForegroundBrush}"
                                    Command="{Binding CopyCommand}" CommandParameter="{Binding}"
                                    ToolTip.Tip="Copy in the selected format">
                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" Foreground="{Binding ForegroundBrush}"/>
                            </Button>

                            <!-- More: rename, move, duplicate, remove -->
                            <Button Classes="iconOnly" Foreground="{Binding ForegroundBrush}" ToolTip.Tip="More actions">
                                <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="14" Height="14" Foreground="{Binding ForegroundBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Left">
                                        <StackPanel x:DataType="models:ColorSwatch" Width="190" Spacing="2" Margin="4">
                                            <TextBlock Text="RENAME" Classes="eyebrow" Margin="4,0,0,2"/>
                                            <TextBox Text="{Binding Name}" Watermark="Name"/>
                                            <Separator Margin="0,6"/>
                                            <Button Classes="menuItem" Command="{Binding MoveUpCommand}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <materialIcons:MaterialIcon Kind="ArrowUp" Width="15" Height="15"/>
                                                    <TextBlock Text="Move up" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="menuItem" Command="{Binding MoveDownCommand}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <materialIcons:MaterialIcon Kind="ArrowDown" Width="15" Height="15"/>
                                                    <TextBlock Text="Move down" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="menuItem" Command="{Binding DuplicateCommand}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <materialIcons:MaterialIcon Kind="ContentDuplicate" Width="15" Height="15"/>
                                                    <TextBlock Text="Duplicate" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="menuItem" Command="{Binding RemoveCommand}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <materialIcons:MaterialIcon Kind="Close" Width="15" Height="15"
                                                                                Foreground="{DynamicResource DangerBrush}"/>
                                                    <TextBlock Text="Remove" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource DangerBrush}"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Compact: small chips, as many as possible (§8 compact view). -->
        <DataTemplate x:Key="CompactCardTemplate" x:DataType="models:ColorSwatch">
            <Border Classes="swatchCard" Classes.selected="{Binding IsSelected}"
                    Background="{Binding Brush}" CornerRadius="10" Margin="4" Width="108" Height="92"
                    Cursor="Hand"
                    AutomationProperties.Name="{Binding Name}"
                    AutomationProperties.AutomationId="{Binding Hex}"
                    PointerPressed="OnSwatchPointerPressed"
                    PointerMoved="OnSwatchPointerMoved"
                    PointerReleased="OnSwatchPointerReleased"
                    ToolTip.Tip="{Binding Hex}">
                <Grid RowDefinitions="Auto,*" Margin="6">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ToggleButton Classes="iconOnly" IsChecked="{Binding IsLocked, Mode=TwoWay}"
                                      ToolTip.Tip="Keep this color when generating">
                            <materialIcons:MaterialIcon
                                Kind="{Binding IsLocked, Converter={x:Static converters:LockIconConverter.Instance}}"
                                Width="12" Height="12" Foreground="{Binding ForegroundBrush}"/>
                        </ToggleButton>
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="1">
                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Foreground="{Binding ForegroundBrush}"/>
                        <TextBlock Text="{Binding Hex}" FontSize="10" Classes="mono" Opacity="0.85"
                                   Foreground="{Binding ForegroundBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="RowPanel"><UniformGrid Rows="1"/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="GridPanel"><WrapPanel/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListPanel"><StackPanel/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="CompactPanel"><WrapPanel/></ItemsPanelTemplate>
    </UserControl.Resources>

    <!-- The palette + the status message pinned to the bottom. Palettes are
         chosen from the library sidebar, so there are no open-palette tabs. -->
    <Border Classes="panel" Padding="14,14,14,10">
        <Grid RowDefinitions="*,Auto,Auto">

            <ScrollViewer Grid.Row="0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Board" ItemsSource="{Binding Palette}"/>
            </ScrollViewer>

            <!-- Empty state: an empty board used to be a blank panel. -->
            <StackPanel Grid.Row="0" IsVisible="{Binding IsPaletteEmpty}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="10" MaxWidth="420">
                <materialIcons:MaterialIcon Kind="PaletteOutline" Width="40" Height="40"
                                            HorizontalAlignment="Center" Opacity="0.5"/>
                <TextBlock Text="This palette is empty" Classes="display small"
                           HorizontalAlignment="Center"/>
                <TextBlock Classes="caption" TextAlignment="Center" TextWrapping="Wrap"
                           Text="Press Space to generate a fresh set of colors, or start from a picture or a single color."/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Button Command="{Binding Studio.GeneratePaletteCommand}"
                            ToolTip.Tip="Generate colors (Space)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="Shuffle" Width="16" Height="16"/>
                            <TextBlock Text="Generate" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding Studio.ExtractFromImageCommand}"
                            ToolTip.Tip="Pull the dominant colors out of an image">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="TrayArrowUp" Width="16" Height="16"/>
                            <TextBlock Text="From image" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding Studio.AddCurrentColorCommand}"
                            ToolTip.Tip="Add the current base color">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                            <TextBlock Text="Add base color" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Board footer: which palette is open on the left, what just
                 happened on the right. -->
            <Separator Grid.Row="1" Margin="2,10,2,0"/>
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="2,4,2,0">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Library.SelectedPalette.Name}"
                               Classes="caption" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                    <TextBlock Text="·" Classes="caption"/>
                    <TextBlock Text="{Binding PaletteCountLabel}" Classes="caption mono"/>
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="{Binding StatusMessage}"
                           Classes="caption mono" FontSize="10.5"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" MaxWidth="420"/>
            </Grid>

        </Grid>
    </Border>
</UserControl>
