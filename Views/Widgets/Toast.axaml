<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:local="using:Spectrum.Views.Widgets"
             x:Class="Spectrum.Views.Widgets.Toast"
             x:CompileBindings="False">

    <!-- Transient toast: fades in above the work area and auto-hides.
         Positioned above the status bar on the right so long status
         messages stay visible while the user acts on the toast. -->
    <Border CornerRadius="10"
            Background="#1A1A1A"
            BorderBrush="#3A3A3A"
            BorderThickness="1"
            Padding="12,10"
            Margin="0,0,0,12"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Width="380">

        <Grid ColumnDefinitions="Auto,*,Auto">
            <!-- Icon (semantic color token). -->
            <Border Width="18" Height="18" CornerRadius="9"
                    Background="{DynamicResource OutlineBrush}">
                <materialIcons:MaterialIcon Kind="InfoOutline"
                                            Width="14" Height="14"
                                            Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>

            <!-- Message text. -->
            <TextBlock Text="{Binding ToastMessage}"
                       FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>

            <!-- Dismiss button (icon-only, monochrome). -->
            <Button Classes="iconOnly" Padding="4,2"
                    Command="{Binding DismissCommand}">
                <materialIcons:MaterialIcon Kind="Close"
                                            Width="14" Height="14"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
