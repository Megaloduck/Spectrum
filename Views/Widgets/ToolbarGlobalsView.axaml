<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spectrum.ViewModels"
             xmlns:converters="using:Spectrum.Converters"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             x:Class="Spectrum.Views.ToolbarGlobalsView"
             x:DataType="vm:MainWindowViewModel">

    <!-- Shared right-hand cluster on every workspace toolbar: the notation a
         swatch copies as, then one click to copy the whole palette. -->
    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <ComboBox Width="104" Height="34"
                  ItemsSource="{Binding CopyFormats}"
                  SelectedItem="{Binding SelectedCopyFormat}"
                  ToolTip.Tip="Notation used when you copy a swatch (HEX, RGB, OKLCH…)">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={x:Static converters:EnumSpacedConverter.Instance}}"
                               FontSize="12"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Classes="iconChip" Height="34" Width="34"
                Command="{Binding CopyAllHexCommand}"
                ToolTip.Tip="Copy the whole palette to the clipboard">
            <materialIcons:MaterialIcon Kind="ContentCopy" Width="16" Height="16"/>
        </Button>
    </StackPanel>

</UserControl>
