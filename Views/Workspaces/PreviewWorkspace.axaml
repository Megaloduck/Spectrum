<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spectrum.ViewModels"
             xmlns:converters="using:Spectrum.Converters"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:local="using:Spectrum.Views"
             x:Class="Spectrum.Views.Workspaces.PreviewWorkspace"
             x:DataType="vm:MainWindowViewModel">

    <!-- Ctrl+2 — See the palette: layout, live mockup, variants, side-by-side compare. -->

    <Grid x:Name="WorkspaceRoot" ColumnDefinitions="*,12,330">

        <GridSplitter Grid.Column="1"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Background="Transparent"
                      Width="12"
                      IsVisible="{Binding InspectorVisible}"
                      ToolTip.Tip="Drag to resize the workspace dock"/>

        <!-- ═══════════════════════════════════════════════════════════════════
             DOCK · PREVIEW : mockup + variants
             ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="2" Classes="panel" IsVisible="{Binding InspectorVisible}">
            <Grid RowDefinitions="Auto,*">

                <!-- Dock header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16,20,10">
                    <StackPanel Spacing="1">
                        <TextBlock Text="PREVIEW" Classes="eyebrow"/>
                        <TextBlock Text="Mockup, variants and compare"
                                   Classes="caption" FontSize="11"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="ghost"
                            Command="{Binding ToggleInspectorCommand}"
                            Padding="6,4"
                            ToolTip.Tip="Collapse the dock (Ctrl+I)">
                        <materialIcons:MaterialIcon Kind="ChevronRight" Width="17" Height="17"/>
                    </Button>
                </Grid>

                <!-- Dock content -->
                <ScrollViewer Grid.Row="1"
                              Padding="20,0,20,20"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" HorizontalAlignment="Stretch">

                        <!-- Mockup surface -->
                        <Border Background="{Binding Preview.MockupBackgroundBrush}"
                                CornerRadius="12" Padding="18"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="1.3">
                            <StackPanel Spacing="12">

                                <!-- Header row -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Project dashboard"
                                               FontWeight="Bold" FontSize="17"
                                               Foreground="{Binding Preview.MockupTextBrush}"/>
                                    <Border Grid.Column="1"
                                            Background="{Binding Preview.MockupAccentBrush}"
                                            CornerRadius="10" Padding="10,4">
                                        <TextBlock Text="Beta"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding Preview.MockupAccentForegroundBrush}"/>
                                    </Border>
                                </Grid>

                                <!-- Body copy -->
                                <TextBlock FontSize="13" TextWrapping="Wrap"
                                           Foreground="{Binding Preview.MockupTextBrush}"
                                           Text="Body copy set in your palette's own most-readable color, so you can judge contrast at a glance."/>

                                <!-- Card -->
                                <Border Background="{Binding Preview.MockupSurfaceBrush}"
                                        CornerRadius="10" Padding="14"
                                        BorderBrush="{DynamicResource OutlineBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Card title"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Preview.MockupTextBrush}"/>
                                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                                   Opacity="0.8"
                                                   Foreground="{Binding Preview.MockupTextBrush}"
                                                   Text="Secondary surfaces use lighter tints derived from the last color in your palette."/>
                                    </StackPanel>
                                </Border>

                                <!-- Buttons -->
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Primary action"
                                            FontWeight="SemiBold"
                                            BorderThickness="0"
                                            Background="{Binding Preview.MockupPrimaryBrush}"
                                            Foreground="{Binding Preview.MockupPrimaryForegroundBrush}"/>
                                    <Button Content="Secondary"
                                            Foreground="{Binding Preview.MockupTextBrush}"
                                            Background="Transparent"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>

                        <!-- Separator before variants -->
                        <Separator Margin="0,4"/>

                        <!-- Variants (§8) — no wrapping border, constrained layout -->
                        <Grid ColumnDefinitions="*,Auto" >

                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="VARIANTS" Classes="eyebrow"/>
                                <TextBlock Classes="caption"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="Generates derived palettes and opens them as a new tab"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Classes="iconOnly" Command="{Binding Preview.GenerateLightVariantCommand}"
                                        ToolTip.Tip="Create a lighter sibling palette from these colors">
                                <materialIcons:MaterialIcon Kind="Flashlight" Width="18" Height="18"/>
                            </Button>
                            <Button Classes="iconOnly" Command="{Binding Preview.GenerateDarkVariantCommand}"
                                        ToolTip.Tip="Create a darker sibling palette from these colors">
                                <materialIcons:MaterialIcon Kind="NightLight" Width="18" Height="18"/>
                            </Button>
                            </StackPanel>

                        </Grid>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             CENTER · toolbar + palette board
             ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*" >

            <!-- Toolbar -->
            <Border Grid.Row="0" Classes="panel" Padding="16,10" Margin="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto">

                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- View mode (§8 grid / list / compact) -->
                        <ComboBox MinWidth="110" Height="38" Margin="0,0,4,0"
                                  ItemsSource="{Binding ViewModes}"
                                  SelectedItem="{Binding ViewMode}"
                                  ToolTip.Tip="Board layout: Row / Grid / List / Compact">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static converters:EnumSpacedConverter.Instance}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Side-by-side comparison (§8) -->
                        <Button Height="38" Margin="0,0,4,0"
                                Command="{Binding Preview.ComparePalettesCommand}"
                                ToolTip.Tip="Compare this palette side-by-side with another one">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ViewColumn" Width="16" Height="16"/>
                                <TextBlock Text="Compare" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Detach (§7 multi-window): lives on the Preview toolbar only. -->
                        <Button Height="38" Margin="0,0,4,0"
                                Command="{Binding DetachWindowCommand}"
                                ToolTip.Tip="Open this palette in a separate window (§7 multi-window)">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="WindowRestore" Width="16" Height="16"/>
                                <TextBlock Text="Detach" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </WrapPanel>

                    <local:ToolbarGlobalsView Grid.Column="1"/>
                </Grid>
            </Border>

            <!-- Palette board -->
            <local:PaletteBoardView Grid.Row="1"/>

        </Grid>

    </Grid>
</UserControl>