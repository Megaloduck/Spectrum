<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spectrum.ViewModels"
             xmlns:models="using:Spectrum.Models"
             xmlns:converters="using:Spectrum.Converters"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:local="using:Spectrum.Views"
             x:Class="Spectrum.Views.Workspaces.PreviewWorkspace"
             x:DataType="vm:MainWindowViewModel">

    <!-- Ctrl+2 — Preview as a *context gallery*: assign palette colors to
         semantic roles once, then judge them across five real scenes. -->

    <Grid x:Name="WorkspaceRoot" ColumnDefinitions="*,12,330">

        <GridSplitter Grid.Column="1"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Background="Transparent"
                      Width="12"
                      IsVisible="{Binding InspectorVisible}"
                      ToolTip.Tip="Drag to resize the workspace dock"/>

        <!-- ═══════════════════════════════════════════════════════════════════
             DOCK · PREVIEW : role mapping + variants
             ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="2" Classes="panel" IsVisible="{Binding InspectorVisible}">
            <Grid RowDefinitions="Auto,*">

                <!-- Dock header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16,20,10">
                    <StackPanel Spacing="1">
                        <TextBlock Text="PREVIEW" Classes="eyebrow"/>
                        <TextBlock Text="Role mapping, scenes and variants"
                                   Classes="caption" FontSize="11"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="ghost"
                            Command="{Binding ToggleInspectorCommand}"
                            Padding="6,4"
                            ToolTip.Tip="Collapse the dock (Ctrl+I)">
                        <materialIcons:MaterialIcon Kind="ChevronRight" Width="17" Height="17"/>
                    </Button>
                </Grid>

                <!-- Dock content -->
                <ScrollViewer Grid.Row="1"
                              Padding="20,0,20,20"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" HorizontalAlignment="Stretch">

                        <!-- Role mapping: assign swatches to semantic roles once;
                             every scene follows the map. Auto = derived default. -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="ROLE MAPPING" Classes="eyebrow"/>
                            <TextBlock Classes="caption" FontSize="11" TextWrapping="Wrap"
                                       Text="Bind palette colors to UI roles. Every scene follows the map; Auto keeps the derived default."/>

                            <ItemsControl ItemsSource="{Binding Preview.Roles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MockupRole">
                                        <!-- Role · ComboBox (stretches, so every row lines up) · reset -->
                                        <Grid ColumnDefinitions="76,*,Auto" Margin="0,3">
                                            <TextBlock Text="{Binding Name}" Classes="caption" FontSize="11"
                                                       VerticalAlignment="Center"/>

                                            <ComboBox Grid.Column="1" MinWidth="0" Height="34" FontSize="12"
                                                      Padding="8,5" Margin="8,0,0,0"
                                                      HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding Options}"
                                                      SelectedIndex="{Binding SelectedOption, Mode=TwoWay}"
                                                      ToolTip.Tip="Choose which palette color plays this role — the chip is the actual color">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:MockupOption">
                                                        <!-- The same template renders the closed box, so the
                                                             current pick always shows its swatch too. -->
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <Border Width="14" Height="14" CornerRadius="4"
                                                                    Background="{Binding Swatch}"
                                                                    BorderBrush="{DynamicResource OutlineBrush}"
                                                                    BorderThickness="1"
                                                                    VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                                       FontSize="12" Margin="7,0"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Hex}"
                                                                       Classes="mono caption" FontSize="11"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <Button Grid.Column="2" Classes="iconOnly" Margin="5,0,0,0"
                                                    Command="{Binding ResetToAutoCommand}"
                                                    IsEnabled="{Binding !IsOverridden}"
                                                    ToolTip.Tip="Reset this role to the derived default (Auto)">
                                                <materialIcons:MaterialIcon Kind="Restore" Width="14" Height="14"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Separator before variants -->
                        <Separator Margin="0,4"/>

                        <!-- Variants (§8) — no wrapping border, constrained layout -->
                        <Grid ColumnDefinitions="*,Auto">

                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="VARIANTS" Classes="eyebrow"/>
                                <TextBlock Classes="caption"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="Generates derived palettes (OKLCH mix) and opens them as a new tab"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Classes="iconOnly" Command="{Binding Preview.GenerateLightVariantCommand}"
                                        ToolTip.Tip="Create a lighter sibling palette from these colors">
                                <materialIcons:MaterialIcon Kind="Flashlight" Width="18" Height="18"/>
                            </Button>
                            <Button Classes="iconOnly" Command="{Binding Preview.GenerateDarkVariantCommand}"
                                        ToolTip.Tip="Create a darker sibling palette from these colors">
                                <materialIcons:MaterialIcon Kind="NightLight" Width="18" Height="18"/>
                            </Button>
                            </StackPanel>

                        </Grid>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             CENTER · toolbar + scene gallery + palette board
             ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,8,300">

            <!-- Toolbar -->
            <Border Grid.Row="0" Classes="panel" Padding="16,10" Margin="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto">

                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Scene switcher: which context to render the palette into -->
                        <ComboBox MinWidth="140" Height="38" Margin="0,0,4,0"
                                  ItemsSource="{Binding Preview.Scenes}"
                                  SelectedItem="{Binding Preview.SelectedScene}"
                                  ToolTip.Tip="Scene: the context your palette is judged in">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static converters:EnumSpacedConverter.Instance}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- View mode (§8 grid / list / compact) -->
                        <ComboBox MinWidth="110" Height="38" Margin="0,0,4,0"
                                  ItemsSource="{Binding ViewModes}"
                                  SelectedItem="{Binding ViewMode}"
                                  ToolTip.Tip="Board layout: Row / Grid / List / Compact">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static converters:EnumSpacedConverter.Instance}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Side-by-side comparison (§8) -->
                        <Button Height="38" Margin="0,0,4,0"
                                Command="{Binding Preview.ComparePalettesCommand}"
                                ToolTip.Tip="Compare this palette side-by-side with another one">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ViewColumn" Width="16" Height="16"/>
                                <TextBlock Text="Compare" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Detach (§7 multi-window): lives on the Preview toolbar only. -->
                        <Button Height="38" Margin="0,0,4,0"
                                Command="{Binding DetachWindowCommand}"
                                ToolTip.Tip="Open this palette in a separate window (§7 multi-window)">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="WindowRestore" Width="16" Height="16"/>
                                <TextBlock Text="Detach" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </WrapPanel>

                    <local:ToolbarGlobalsView Grid.Column="1"/>
                </Grid>
            </Border>

            <!-- ═══ Scene gallery: the selected context, rendered from the role map ═══ -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Border Background="{Binding Preview.BackgroundBrush}"
                        CornerRadius="16" Padding="26"
                        BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1.3"
                        MaxWidth="900"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,0,4">

                    <Panel>

                        <!-- ── Scene: Dashboard ── -->
                        <StackPanel Spacing="16" IsVisible="{Binding Preview.IsSceneDashboard}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Project dashboard" FontWeight="Bold" FontSize="20"
                                               Foreground="{Binding Preview.TextBrush}"/>
                                    <TextBlock Text="Primary drives the header and main actions"
                                               FontSize="12" Foreground="{Binding Preview.MutedTextBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="{Binding Preview.AccentBrush}"
                                        CornerRadius="10" Padding="11,5">
                                    <TextBlock Text="Beta"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{Binding Preview.AccentForegroundBrush}"/>
                                </Border>
                            </Grid>

                            <TextBlock FontSize="13" TextWrapping="Wrap"
                                       Foreground="{Binding Preview.MutedTextBrush}"
                                       Text="Body copy uses the most readable color the palette offers, so contrast problems show up here first."/>

                            <!-- Stat cards -->
                            <Grid ColumnDefinitions="*,12,*" MaxWidth="520" HorizontalAlignment="Left">
                                <Border Background="{Binding Preview.SurfaceBrush}"
                                        CornerRadius="12" Padding="16"
                                        BorderBrush="{Binding Preview.BorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Active users" FontSize="11"
                                                   Foreground="{Binding Preview.MutedTextBrush}"/>
                                        <TextBlock Text="12,480" FontWeight="Bold" FontSize="22"
                                                   Foreground="{Binding Preview.TextBrush}"/>
                                        <Border Background="{Binding Preview.PrimaryBrush}" CornerRadius="6"
                                                HorizontalAlignment="Left" Padding="7,2">
                                            <TextBlock Text="+8.2%" FontSize="10" FontWeight="Bold"
                                                       Foreground="{Binding Preview.PrimaryForegroundBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{Binding Preview.SurfaceBrush}"
                                        CornerRadius="12" Padding="16"
                                        BorderBrush="{Binding Preview.BorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Conversion" FontSize="11"
                                                   Foreground="{Binding Preview.MutedTextBrush}"/>
                                        <TextBlock Text="3.9%" FontWeight="Bold" FontSize="22"
                                                   Foreground="{Binding Preview.TextBrush}"/>
                                        <Border Background="{Binding Preview.AccentBrush}" CornerRadius="6"
                                                HorizontalAlignment="Left" Padding="7,2">
                                            <TextBlock Text="Goal 4.5%" FontSize="10" FontWeight="Bold"
                                                       Foreground="{Binding Preview.AccentForegroundBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Card + actions -->
                            <Border Background="{Binding Preview.SurfaceBrush}"
                                    CornerRadius="12" Padding="16" MaxWidth="520" HorizontalAlignment="Left"
                                    BorderBrush="{Binding Preview.BorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Card title" FontWeight="SemiBold"
                                               Foreground="{Binding Preview.TextBrush}"/>
                                    <TextBlock FontSize="12" TextWrapping="Wrap"
                                               Foreground="{Binding Preview.MutedTextBrush}"
                                               Text="Secondary surfaces use the Surface role; the hairline is the Border role."/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Primary action"
                                        FontWeight="SemiBold"
                                        BorderThickness="0"
                                        Background="{Binding Preview.PrimaryBrush}"
                                        Foreground="{Binding Preview.PrimaryForegroundBrush}"/>
                                <Button Content="Secondary"
                                        Foreground="{Binding Preview.TextBrush}"
                                        Background="Transparent"
                                        BorderBrush="{Binding Preview.BorderBrush}"
                                        BorderThickness="1"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ── Scene: Landing ── -->
                        <StackPanel Spacing="28" IsVisible="{Binding Preview.IsSceneLanding}">
                            <!-- Nav -->
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="7"
                                            Background="{Binding Preview.PrimaryBrush}"/>
                                    <TextBlock Text="Yourbrand" FontWeight="Bold" FontSize="14"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Preview.TextBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Features" FontSize="12" Foreground="{Binding Preview.MutedTextBrush}"/>
                                    <TextBlock Text="Pricing" FontSize="12" Foreground="{Binding Preview.MutedTextBrush}"/>
                                    <TextBlock Text="Docs" FontSize="12" Foreground="{Binding Preview.MutedTextBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Sign up" FontSize="12" Padding="14,7"
                                        BorderThickness="0" FontWeight="SemiBold"
                                        Background="{Binding Preview.PrimaryBrush}"
                                        Foreground="{Binding Preview.PrimaryForegroundBrush}"/>
                            </Grid>

                            <!-- Hero -->
                            <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Center">
                                <TextBlock Text="Colors that carry your product" FontWeight="Bold" FontSize="30"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{Binding Preview.TextBrush}"/>
                                <TextBlock Text="The hero headline is the hardest test for any palette: big type on the page background, judged at a glance."
                                           FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{Binding Preview.MutedTextBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <Button Content="Start free" Padding="18,10" BorderThickness="0"
                                            FontWeight="SemiBold"
                                            Background="{Binding Preview.PrimaryBrush}"
                                            Foreground="{Binding Preview.PrimaryForegroundBrush}"/>
                                    <Button Content="Live demo" Padding="18,10"
                                            Foreground="{Binding Preview.TextBrush}"
                                            Background="{Binding Preview.SurfaceBrush}"
                                            BorderBrush="{Binding Preview.BorderBrush}"
                                            BorderThickness="1"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Feature cards -->
                            <Grid ColumnDefinitions="*,12,*,12,*" HorizontalAlignment="Stretch">
                                <Border Background="{Binding Preview.SurfaceBrush}" CornerRadius="12" Padding="16"
                                        BorderBrush="{Binding Preview.BorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <Border Width="30" Height="30" CornerRadius="9"
                                                Background="{Binding Preview.PrimaryBrush}"/>
                                        <TextBlock Text="Fast" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{Binding Preview.TextBrush}"/>
                                        <TextBlock Text="Accent chips at small sizes." FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{Binding Preview.MutedTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{Binding Preview.SurfaceBrush}" CornerRadius="12" Padding="16"
                                        BorderBrush="{Binding Preview.BorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <Border Width="30" Height="30" CornerRadius="9"
                                                Background="{Binding Preview.AccentBrush}"/>
                                        <TextBlock Text="Clear" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{Binding Preview.TextBrush}"/>
                                        <TextBlock Text="Accent role on cards." FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{Binding Preview.MutedTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Background="{Binding Preview.SurfaceBrush}" CornerRadius="12" Padding="16"
                                        BorderBrush="{Binding Preview.BorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <Border Width="30" Height="30" CornerRadius="9"
                                                Background="{Binding Preview.BorderBrush}"/>
                                        <TextBlock Text="Quiet" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{Binding Preview.TextBrush}"/>
                                        <TextBlock Text="Border role does the work." FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{Binding Preview.MutedTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- ── Scene: Mobile ── -->
                        <Grid IsVisible="{Binding Preview.IsSceneMobile}">
                            <Border Width="272" Height="500" CornerRadius="30"
                                    Background="{Binding Preview.BackgroundBrush}"
                                    BorderBrush="{Binding Preview.BorderBrush}" BorderThickness="2"
                                    HorizontalAlignment="Center">
                                <Grid RowDefinitions="Auto,*,Auto" Margin="14">

                                    <!-- App bar -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,6,2,10">
                                        <TextBlock Text="9:41" FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Preview.TextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="Inbox" FontWeight="Bold" FontSize="15"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{Binding Preview.TextBrush}"/>
                                        <Border Grid.Column="2" Width="26" Height="26" CornerRadius="13"
                                                Background="{Binding Preview.PrimaryBrush}"
                                                VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- List rows -->
                                    <StackPanel Grid.Row="1" Spacing="8">
                                        <Border Background="{Binding Preview.SurfaceBrush}" CornerRadius="12" Padding="12"
                                                BorderBrush="{Binding Preview.BorderBrush}" BorderThickness="1">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Border Width="30" Height="30" CornerRadius="10"
                                                        Background="{Binding Preview.PrimaryBrush}"/>
                                                <StackPanel Grid.Column="1" Spacing="3" Margin="10,0,0,0">
                                                    <TextBlock Text="New comment" FontWeight="SemiBold" FontSize="12"
                                                               Foreground="{Binding Preview.TextBrush}"/>
                                                    <TextBlock Text="Ana mentioned you" FontSize="10.5"
                                                               Foreground="{Binding Preview.MutedTextBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Background="{Binding Preview.SurfaceBrush}" CornerRadius="12" Padding="12"
                                                BorderBrush="{Binding Preview.BorderBrush}" BorderThickness="1">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Border Width="30" Height="30" CornerRadius="10"
                                                        Background="{Binding Preview.AccentBrush}"/>
                                                <StackPanel Grid.Column="1" Spacing="3" Margin="10,0,0,0">
                                                    <TextBlock Text="Deploy finished" FontWeight="SemiBold" FontSize="12"
                                                               Foreground="{Binding Preview.TextBrush}"/>
                                                    <TextBlock Text="v2.4 is live" FontSize="10.5"
                                                               Foreground="{Binding Preview.MutedTextBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Background="{Binding Preview.SurfaceBrush}" CornerRadius="12" Padding="12"
                                                BorderBrush="{Binding Preview.BorderBrush}" BorderThickness="1">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Weekly digest" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{Binding Preview.TextBrush}"/>
                                                <TextBlock Text="12 new insights this week" FontSize="10.5"
                                                           Foreground="{Binding Preview.MutedTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Bottom action -->
                                    <Button Grid.Row="2" Content="Compose" Margin="20,10,20,2" BorderThickness="0"
                                            FontWeight="SemiBold"
                                            Background="{Binding Preview.PrimaryBrush}"
                                            Foreground="{Binding Preview.PrimaryForegroundBrush}"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ── Scene: Chart ── -->
                        <StackPanel Spacing="16" IsVisible="{Binding Preview.IsSceneChart}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Quarterly revenue" FontWeight="Bold" FontSize="18"
                                           Foreground="{Binding Preview.TextBrush}"/>
                                <TextBlock Text="Bars cycle the palette — watch which neighbors blur together"
                                           FontSize="12" Foreground="{Binding Preview.MutedTextBrush}"/>
                            </StackPanel>

                            <Border Background="{Binding Preview.SurfaceBrush}" CornerRadius="12" Padding="20,16"
                                    BorderBrush="{Binding Preview.BorderBrush}" BorderThickness="1"
                                    MaxWidth="560" HorizontalAlignment="Left">
                                <StackPanel Spacing="10">
                                    <!-- Bars -->
                                    <ItemsControl ItemsSource="{Binding Preview.ChartBars}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="14"
                                                            HorizontalAlignment="Center"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChartBar">
                                                <Border Width="48" Height="160" VerticalAlignment="Bottom"
                                                        Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8">
                                                    <Border Height="{Binding Height}" VerticalAlignment="Bottom"
                                                            CornerRadius="8" Width="48"
                                                            Background="{Binding Brush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Axis -->
                                    <Border Height="1" Background="{Binding Preview.BorderBrush}"/>

                                    <!-- Legend -->
                                    <ItemsControl ItemsSource="{Binding Palette}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ColorSwatch">
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,12,2"
                                                            VerticalAlignment="Center">
                                                    <Border Width="10" Height="10" CornerRadius="3"
                                                            Background="{Binding Brush}"
                                                            BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                                               Foreground="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).Preview.TextBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Scene: Poster ── -->
                        <Grid IsVisible="{Binding Preview.IsScenePoster}">
                            <Border Background="{Binding Preview.PrimaryBrush}" CornerRadius="18"
                                    Padding="30" MinHeight="420">
                                <Panel>
                                    <!-- Decorative geometry in secondary roles -->
                                    <Border Width="220" Height="220" CornerRadius="110"
                                            Background="{Binding Preview.AccentBrush}" Opacity="0.85"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-40,-60,0"/>
                                    <Border Width="120" Height="120" CornerRadius="16"
                                            Background="{Binding Preview.SurfaceBrush}" Opacity="0.9"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-30,0,0,-30">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="18"/>
                                        </Border.RenderTransform>
                                    </Border>

                                    <Grid RowDefinitions="*,Auto" Margin="6">
                                        <StackPanel VerticalAlignment="Top" Spacing="10" MaxWidth="360">
                                            <TextBlock Text="SPECTRUM" FontSize="13" FontWeight="Bold" LetterSpacing="4"
                                                       Foreground="{Binding Preview.PrimaryForegroundBrush}"/>
                                            <TextBlock Text="Color, in context" FontWeight="Bold" FontSize="40"
                                                       TextWrapping="Wrap"
                                                       Foreground="{Binding Preview.PrimaryForegroundBrush}"/>
                                            <TextBlock Text="A poster flips the ratio: Primary becomes the field, foreground becomes the voice."
                                                       FontSize="13" TextWrapping="Wrap" Opacity="0.9"
                                                       Foreground="{Binding Preview.PrimaryForegroundBrush}"/>
                                        </StackPanel>

                                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" VerticalAlignment="Bottom">
                                            <Border Background="{Binding Preview.BackgroundBrush}" CornerRadius="8"
                                                    Padding="10,5" VerticalAlignment="Center">
                                                <TextBlock Text="OCT 12 · STUDIO HALL" FontSize="11" FontWeight="Bold"
                                                           Foreground="{Binding Preview.TextBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="spectrum.app" FontSize="11"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{Binding Preview.PrimaryForegroundBrush}"/>
                                        </Grid>
                                    </Grid>
                                </Panel>
                            </Border>
                        </Grid>

                    </Panel>
                </Border>
            </ScrollViewer>

            <!-- Resizable split between gallery and board -->
            <GridSplitter Grid.Row="2" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" Height="8"/>

            <!-- Palette board: still here so colors can be picked, locked, reordered -->
            <local:PaletteBoardView Grid.Row="3"/>

        </Grid>

    </Grid>
</UserControl>
