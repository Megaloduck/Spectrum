<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spectrum.ViewModels"
             xmlns:converters="using:Spectrum.Converters"
             xmlns:local="using:Spectrum.Views"
             xmlns:services="using:Spectrum.Services"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             x:Class="Spectrum.Views.Workspaces.ExportWorkspace"
             x:DataType="vm:MainWindowViewModel">

    <!-- Ctrl+4 — Move files in and out: export presets, PNG sheet, imports.
         The board steps aside here, so this workspace fills the whole column. -->

    <UserControl.Styles>
        <!-- PNG / JPG pill: the same segmented idea as the Preview workspace's
             theme switch, scaled down to fit this panel. -->
        <Style Selector="Button.sheetTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.sheetTab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
        </Style>

        <Style Selector="Button.sheetTab.active">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.sheetTab.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Toolbar: no workspace-specific controls — status + shared actions. -->
        <Border Grid.Row="0" Classes="panel" Padding="12,8" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock Text="{Binding Library.SelectedPalette.Name}"
                               Classes="caption" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="·" Classes="caption"/>
                    <TextBlock Text="{Binding StatusMessage}" Classes="caption mono" FontSize="10.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                </StackPanel>
                <local:ToolbarGlobalsView Grid.Column="1"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="1.35*,10,*">

            <!-- ═══ EXPORT ═══ -->
            <Border Grid.Column="0" Classes="panel" Padding="18">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Text="EXPORT PALETTE" Classes="eyebrow"/>
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="Text formats build a preview you can copy; ASE / ACO and the PNG / JPG sheet write straight to a file."/>
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto" Margin="0,14,0,0">
                        <ComboBox MinWidth="168" Height="34"
                                  ItemsSource="{Binding Export.ExportFormats}"
                                  SelectedItem="{Binding Export.SelectedExportFormat}"
                                  ToolTip.Tip="Format used by Build preview / Save / Copy">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static converters:EnumSpacedConverter.Instance}}"
                                               FontSize="12"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Height="34" Margin="6,0,0,0" FontWeight="SemiBold"
                                Command="{Binding Export.BuildExportPreviewCommand}"
                                ToolTip.Tip="Build the export preview">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ViewList" Width="15" Height="15"/>
                                <TextBlock Text="Build preview" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Code: always mono, on a quiet inset surface. -->
                    <Border Grid.Row="2" Classes="well" Margin="0,12,0,0">
                        <TextBox Text="{Binding Export.ExportPreview}" AcceptsReturn="True"
                                 IsReadOnly="True"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="12,10"
                                 TextWrapping="Wrap" Classes="mono" FontSize="11.5"
                                 VerticalContentAlignment="Top"
                                 Watermark="Press Build preview to see the generated source"/>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="0,12,0,0">
                        <Button Height="34" Command="{Binding Export.CopyExportCommand}"
                                ToolTip.Tip="Copy the export to the clipboard">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14"/>
                                <TextBlock Text="Copy" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Height="34" Command="{Binding Export.ExportToFileCommand}"
                                ToolTip.Tip="ASE / ACO and other binary formats always write to disk (Ctrl+E)">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="14" Height="14"/>
                                <TextBlock Text="Save file" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Swatch sheet: the image is rendered up front, so what is on
                         screen is exactly what Save sheet writes. -->
                    <StackPanel Grid.Row="4" Spacing="10" Margin="0,14,0,0">
                        <Separator/>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="SWATCH SHEET" Classes="eyebrow"/>
                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="Every swatch as one shareable image — previewed exactly as it saves."/>
                            </StackPanel>

                            <Border Grid.Column="1" Padding="3" Margin="12,0,0,0" VerticalAlignment="Top"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                                    CornerRadius="999"
                                    ToolTip.Tip="Image format for Save sheet">
                                <StackPanel Orientation="Horizontal" Spacing="1">
                                    <Button Classes="sheetTab" Classes.active="{Binding Export.IsPngSheet}"
                                            AutomationProperties.Name="Save the sheet as PNG"
                                            AutomationProperties.AutomationId="SheetFormatPng"
                                            Command="{Binding Export.SelectSheetFormatCommand}"
                                            CommandParameter="{x:Static services:SheetImageFormat.Png}"
                                            Content="PNG"
                                            ToolTip.Tip="Lossless — crisp edges, larger file"/>
                                    <Button Classes="sheetTab" Classes.active="{Binding Export.IsJpgSheet}"
                                            AutomationProperties.Name="Save the sheet as JPG"
                                            AutomationProperties.AutomationId="SheetFormatJpg"
                                            Command="{Binding Export.SelectSheetFormatCommand}"
                                            CommandParameter="{x:Static services:SheetImageFormat.Jpg}"
                                            Content="JPG"
                                            ToolTip.Tip="Smaller file for sharing — slight artifacts on flat color"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Classes="well" Height="168" Padding="8">
                            <Grid>
                                <Image Source="{Binding Export.SheetPreview}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Add colors to the palette and the sheet appears here."
                                           Classes="caption" TextAlignment="Center" TextWrapping="Wrap"
                                           MaxWidth="260"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding Export.IsSheetPreviewEmpty}"/>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Export.SheetSizeLabel}"
                                       Classes="caption mono" FontSize="10.5"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Height="32" FontWeight="SemiBold"
                                    Command="{Binding Export.SaveSheetCommand}"
                                    ToolTip.Tip="Write the swatch sheet in the selected format (Ctrl+J)">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Image" Width="14" Height="14"/>
                                    <TextBlock Text="{Binding Export.SaveSheetLabel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ IMPORT ═══ -->
            <Border Grid.Column="2" Classes="panel" Padding="18">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Spacing="2">
                        <TextBlock Text="IMPORT" Classes="eyebrow"/>
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="Bring palettes in, or move the whole library between machines."/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="6" Margin="0,14,0,0">
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="34"
                                Command="{Binding Library.ImportPaletteFileCommand}"
                                ToolTip.Tip="Import a CSS / GPL / ASE / ACO palette file">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="FileImportOutline" Width="15" Height="15"/>
                                <TextBlock Text="Import palette file…" VerticalAlignment="Center"/>
                                <TextBlock Text="CSS · GPL · ASE · ACO" Classes="caption mono" FontSize="10"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="34"
                                Command="{Binding LoadPaletteCommand}"
                                ToolTip.Tip="Load a palette from a JSON file (Ctrl+O)">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15"/>
                                <TextBlock Text="Load palette from file…" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Separator Margin="0,10,0,2"/>
                        <TextBlock Text="WHOLE LIBRARY" Classes="eyebrow"/>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="34"
                                Command="{Binding Library.ExportLibraryCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="CloudDownloadOutline" Width="15" Height="15"/>
                                <TextBlock Text="Export whole library…" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="34"
                                Command="{Binding Library.ImportLibraryCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="FolderUploadOutline" Width="15" Height="15"/>
                                <TextBlock Text="Import library…" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Separator Margin="0,10,0,2"/>
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="Everything is stored locally — JSON or SQLite, switchable in Settings. No account, no cloud."/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

    </Grid>
</UserControl>
