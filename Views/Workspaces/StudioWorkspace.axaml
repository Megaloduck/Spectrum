<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spectrum.ViewModels"
             xmlns:models="using:Spectrum.Models"
             xmlns:converters="using:Spectrum.Converters"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:local="using:Spectrum.Views"
             x:Class="Spectrum.Views.Workspaces.StudioWorkspace"
             x:DataType="vm:MainWindowViewModel">

    <!-- Ctrl+1 — Build the palette: harmony rule, eyedroppers, sliders, board. -->

    <Grid x:Name="WorkspaceRoot" ColumnDefinitions="*,12,330">

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      Background="Transparent" Width="12"
                      IsVisible="{Binding InspectorVisible}"
                      ToolTip.Tip="Drag to resize the workspace dock"/>

        <!-- ============ DOCK · STUDIO: edit the base color ============ -->
        <Border Grid.Column="2" Classes="panel" IsVisible="{Binding InspectorVisible}">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto" Margin="20,16,20,4">
                    <StackPanel Spacing="1">
                        <TextBlock Text="EDIT COLOR" Classes="eyebrow"/>
                        <TextBlock Text="Harmony, eyedroppers and sliders" Classes="caption" FontSize="11"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ghost" Command="{Binding ToggleInspectorCommand}"
                            Padding="6,4" ToolTip.Tip="Collapse the dock (Ctrl+I)">
                        <materialIcons:MaterialIcon Kind="ChevronRight" Width="17" Height="17"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1">
                     <StackPanel Spacing="12"  Margin="20,8,20,20" >

                    <!-- Base color swatch with its auto-name overlaid, bottom-left.
                         Click opens the spectrum picker (§2 color wheel/spectrum). -->
                    <Border Background="{Binding BaseColorBrush}" Height="150" CornerRadius="14"
                            BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1.3"
                            Cursor="Hand" PointerPressed="OnBasePreviewPressed"
                            ToolTip.Tip="Click to open the full color picker (spectrum, RGB/HSL/HSV input)">
                        <TextBlock Text="{Binding BaseColorName}" Foreground="{Binding BaseForegroundBrush}"
                                   FontWeight="Bold" FontSize="14"
                                   Margin="14" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                    </Border>

                    <Grid ColumnDefinitions="88,*,Auto">
                        <ComboBox Grid.Column="0" SelectedIndex="0" Margin="0,0,8,0" HorizontalAlignment="Stretch"
                                  ToolTip.Tip="Manual input format (HEX entry)">
                            <ComboBoxItem Content="HEX"/>
                        </ComboBox>
                        <TextBox Grid.Column="1" Text="{Binding BaseHex}" Classes="mono" Watermark="#RRGGBB"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Classes="iconOnly" Height="34" Padding="8,6"
                                Command="{Binding PasteColorCommand}"
                                ToolTip.Tip="Paste a color from the clipboard (HEX / RGB / HSL)">
                            <materialIcons:MaterialIcon Kind="ClipboardArrowDownOutline" Width="16" Height="16"/>
                        </Button>
                    </Grid>
                        <Button Content="Add to Palette" Command="{Binding AddCurrentColorCommand}"
                                HorizontalAlignment="Stretch"/>

                    <!-- Picked-color history (§3): click to reload into the color panel -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="RECENT PICKS" Classes="eyebrow"/>
                        <TextBlock Classes="caption" FontSize="11"
                                   Text="Screen eyedropper: Ctrl+Alt+P · click a swatch to reuse"
                                   TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding RecentPicks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RecentPick">
                                    <Button Margin="0,0,6,6" Padding="0"
                                            Background="Transparent" BorderThickness="0"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ApplyRecentPickCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding Name}">
                                        <Border Width="32" Height="32" CornerRadius="8"
                                                Background="{Binding Brush}"
                                                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>



                         <!-- Color Generator Slider -->
                    <StackPanel         >

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Hue" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="{Binding Hue, StringFormat=N0}" Classes="caption"/>    
                        </Grid>
                        <Grid Height="40">

    <!-- Actual gradient bar -->
    <Border Height="8"
            VerticalAlignment="Center"
            CornerRadius="4"
            Background="{Binding HueTrackBrush}"/>

    <!-- Interactive slider -->
    <Slider Minimum="0"
            Maximum="360"   
            Value="{Binding Hue}"
            Background="Transparent"/>

</Grid>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                            <TextBlock Text="Saturation" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="{Binding Saturation, StringFormat=N0}" Classes="caption"/>
                        </Grid>
                        <Grid Height="40">

    <Border Height="8"
            VerticalAlignment="Center"
            CornerRadius="4"
            Background="{Binding SaturationTrackBrush}"/>

    <Slider Minimum="0"
            Maximum="100"
            Value="{Binding Saturation}"
            Background="Transparent"/>

</Grid>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                            <TextBlock Text="Brightness" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="{Binding Lightness, StringFormat=N0}" Classes="caption"/>
                        </Grid>
                        <Grid Height="40">

    <Border Height="8"
            VerticalAlignment="Center"
            CornerRadius="4"
            Background="{Binding BrightnessTrackBrush}"/>

    <Slider Minimum="0"
            Maximum="100"
            Value="{Binding Lightness}"
            Background="Transparent"/>

</Grid>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                            <TextBlock Text="Temperature" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="{Binding Temperature, StringFormat=N0}" Classes="caption"/>
                        </Grid>
                        <Grid Height="40">

    <Border Height="8"
            VerticalAlignment="Center"
            CornerRadius="4"
            Background="{Binding TemperatureTrackBrush}"/>

    <Slider Minimum="-100"
            Maximum="100"
            Value="{Binding Temperature}"
            Background="Transparent"/>

</Grid>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                            <TextBlock Text="Opacity" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="{Binding AlphaLabel}" Classes="caption"/>
                        </Grid>
                        <Grid Height="40">

    <Border Height="8"
            VerticalAlignment="Center"
            CornerRadius="4"
            Background="{Binding AlphaTrackBrush}"/>

    <Slider Minimum="0"
            Maximum="100"
            Value="{Binding Alpha}"
            Background="Transparent"/>

</Grid>

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

                 <!-- Harmonize Button -->
                 <StackPanel Grid.Row="2" Margin="20,14,20,16"  Spacing="10">
                     <Separator VerticalAlignment="Center"/>
                     <Button Content="Press Space to Harmonize" Command="{Binding GeneratePaletteCommand}"
                            HorizontalAlignment="Stretch" ToolTip.Tip="Regenerates every unlocked color — using the Harmonize tool if one is selected"/>
                 </StackPanel>

            </Grid>
        </Border>

        <!-- ============ CENTER: toolbar + palette board ============ -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">

            <!-- Toolbar: Studio's own controls on the left, the shared
                 history/file actions pinned on the right. -->
            <Border Grid.Row="0" Classes="panel" Padding="16,10" Margin="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Harmony Type ComboBox -->
                    <ComboBox MinWidth="150" Height="38" Margin="0,0,4,0"
                              ItemsSource="{Binding HarmonyTypes}" SelectedItem="{Binding SelectedHarmony}"
                              ToolTip.Tip="Rule Generate/Space uses for unlocked colors">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static converters:EnumSpacedConverter.Instance}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Divider 1 (rule | picking) -->
                    <Border Width="1" Height="24" Margin="12,0"
                            Background="{DynamicResource OutlineBrush}" Opacity="0.5"/>

                    <!-- Extract from Image -->
                    <Button Height="38" Margin="0,0,4,0"
                            Command="{Binding ExtractFromImageCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="TrayArrowUp" Width="16" Height="16"/>
                            <TextBlock Text="Extract from Image" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Screen eyedropper (§3) -->
                    <Button Height="38" Margin="0,0,4,0"
                            Command="{Binding PickFromScreenCommand}"
                            ToolTip.Tip="Pick a color from anywhere on screen — global hotkey Ctrl+Alt+P (local only)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Eyedropper" Width="16" Height="16"/>
                            <TextBlock Text="Screen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- In-app image eyedropper (§3) -->
                    <Button Height="38" Margin="0,0,4,0"
                            Command="{Binding PickFromImageCommand}"
                            ToolTip.Tip="Pick a color from a specific pixel of an image">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Crosshairs" Width="16" Height="16"/>
                            <TextBlock Text="Image" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </WrapPanel>

                <local:ToolbarGlobalsView Grid.Column="1"/>
                </Grid>
            </Border>

            <local:PaletteBoardView Grid.Row="1"/>

        </Grid>

    </Grid>
</UserControl>
