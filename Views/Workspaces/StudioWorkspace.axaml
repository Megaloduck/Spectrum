<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spectrum.ViewModels"
             xmlns:models="using:Spectrum.Models"
             xmlns:converters="using:Spectrum.Converters"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:local="using:Spectrum.Views"
             x:Class="Spectrum.Views.Workspaces.StudioWorkspace"
             x:DataType="vm:MainWindowViewModel">

    <!-- Ctrl+1 — Studio: build the palette. The dock is the COLOR PANEL (one
         base color, sliders and history); the centre is the board. -->

    <Grid x:Name="WorkspaceRoot" ColumnDefinitions="*,12,330">

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      Background="Transparent" Width="12"
                      IsVisible="{Binding InspectorVisible}"
                      ToolTip.Tip="Drag to resize the workspace dock"/>

        <!-- ═══════════════════ DOCK · COLOR PANEL ═══════════════════ -->
        <Border Grid.Column="2" Classes="panel" IsVisible="{Binding InspectorVisible}">
            <Grid RowDefinitions="Auto,*,Auto">

                <Grid ColumnDefinitions="*,Auto" Margin="18,16,12,10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="COLOR PANEL" Classes="eyebrow"/>
                        <TextBlock Text="{Binding Studio.BaseColorName}" Classes="title"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="iconChip ghost" Width="28" Height="28"
                            VerticalAlignment="Top"
                            Command="{Binding ToggleInspectorCommand}"
                            ToolTip.Tip="Collapse the dock (Ctrl+I)">
                        <materialIcons:MaterialIcon Kind="ChevronRight" Width="16" Height="16"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10" Margin="18,0,18,12">

                        <!-- Base color: the color is the hero; name + hex sit on it. -->
                        <Border Background="{Binding Studio.BaseColorBrush}" Height="112" CornerRadius="12"
                                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                                Cursor="Hand" PointerPressed="OnBasePreviewPressed"
                                ToolTip.Tip="Click to open the full color picker (spectrum, RGB/HSL/HSV input)">
                            <Grid RowDefinitions="*,Auto" Margin="14">
                                <Button Classes="iconOnly" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Foreground="{Binding Studio.BaseForegroundBrush}"
                                        Command="{Binding Studio.OpenColorPickerCommand}"
                                        ToolTip.Tip="Open the spectrum picker">
                                    <materialIcons:MaterialIcon Kind="Palette" Width="15" Height="15"
                                                                Foreground="{Binding Studio.BaseForegroundBrush}"/>
                                </Button>

                                <StackPanel Grid.Row="1" Spacing="1">
                                    <TextBlock Text="{Binding Studio.BaseColorName}" FontWeight="Bold" FontSize="15"
                                               Foreground="{Binding Studio.BaseForegroundBrush}"/>
                                    <TextBlock Text="{Binding Studio.BaseHex}" Classes="mono" FontSize="11.5"
                                               Opacity="0.8"
                                               Foreground="{Binding Studio.BaseForegroundBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- HEX entry -->
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="HEX" Classes="eyebrow"/>
                                <TextBlock Grid.Column="1" Text="Paste any notation"
                                           Classes="caption" FontSize="10.5"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,4,Auto,4,Auto">
                                <TextBox Text="{Binding Studio.BaseHex}" Classes="mono"
                                         Watermark="#RRGGBB" FontSize="12.5"/>
                                <Button Grid.Column="2" Classes="iconChip"
                                        Command="{Binding Studio.PasteColorCommand}"
                                        ToolTip.Tip="Paste a color from the clipboard (HEX / RGB / HSL)">
                                    <materialIcons:MaterialIcon Kind="ClipboardArrowDownOutline" Width="16" Height="16"/>
                                </Button>
                                <Button Grid.Column="4" Classes="iconChip"
                                        Command="{Binding Studio.OpenColorPickerCommand}"
                                        ToolTip.Tip="Open the full picker">
                                    <materialIcons:MaterialIcon Kind="Tune" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Recent picks + eyedropper -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="RECENT PICKS" Classes="eyebrow"/>
                                <Button Grid.Column="1" Classes="iconChip ghost" Width="28" Height="28"
                                        Command="{Binding Studio.PickFromScreenCommand}"
                                        ToolTip.Tip="Screen eyedropper (Ctrl+Alt+P)">
                                    <materialIcons:MaterialIcon Kind="Eyedropper" Width="15" Height="15"/>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Studio.RecentPicks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:RecentPick">
                                        <Button Margin="0,0,6,6" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                CornerRadius="8"
                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).Studio.ApplyRecentPickCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding Name}">
                                            <Border Width="30" Height="30" CornerRadius="8"
                                                    Background="{Binding Brush}"
                                                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>

                        <Separator Margin="0,0,0,2"/>

                        <!-- ===== Sliders: gradient track + hairline label row ===== -->
                        <StackPanel Spacing="8">

                            <!-- Hue -->
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Hue" Classes="label"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Studio.Hue, StringFormat=N0}"
                                               Classes="caption mono" FontSize="11"/>
                                </Grid>
                                <Grid Height="26">
                                    <Border Height="8" VerticalAlignment="Center" CornerRadius="4"
                                            Background="{Binding Studio.HueTrackBrush}"/>
                                    <Slider Classes="overlay" Minimum="0" Maximum="360" Value="{Binding Studio.Hue}"
                                            Background="Transparent"/>
                                </Grid>
                            </StackPanel>

                            <!-- Saturation -->
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Saturation" Classes="label"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Studio.Saturation, StringFormat=N0}"
                                               Classes="caption mono" FontSize="11"/>
                                </Grid>
                                <Grid Height="26">
                                    <Border Height="8" VerticalAlignment="Center" CornerRadius="4"
                                            Background="{Binding Studio.SaturationTrackBrush}"/>
                                    <Slider Classes="overlay" Minimum="0" Maximum="100" Value="{Binding Studio.Saturation}"
                                            Background="Transparent"/>
                                </Grid>
                            </StackPanel>

                            <!-- Brightness -->
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Brightness" Classes="label"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Studio.Lightness, StringFormat=N0}"
                                               Classes="caption mono" FontSize="11"/>
                                </Grid>
                                <Grid Height="26">
                                    <Border Height="8" VerticalAlignment="Center" CornerRadius="4"
                                            Background="{Binding Studio.BrightnessTrackBrush}"/>
                                    <Slider Classes="overlay" Minimum="0" Maximum="100" Value="{Binding Studio.Lightness}"
                                            Background="Transparent"/>
                                </Grid>
                            </StackPanel>

                            <!-- Temperature -->
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Temperature" Classes="label"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Studio.Temperature, StringFormat=N0}"
                                               Classes="caption mono" FontSize="11"/>
                                </Grid>
                                <Grid Height="26">
                                    <Border Height="8" VerticalAlignment="Center" CornerRadius="4"
                                            Background="{Binding Studio.TemperatureTrackBrush}"/>
                                    <Slider Classes="overlay" Minimum="-100" Maximum="100" Value="{Binding Studio.Temperature}"
                                            Background="Transparent"/>
                                </Grid>
                            </StackPanel>

                            <!-- Opacity -->
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Opacity" Classes="label"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Studio.AlphaLabel}"
                                               Classes="caption mono" FontSize="11"/>
                                </Grid>
                                <Grid Height="26">
                                    <Border Height="8" VerticalAlignment="Center" CornerRadius="4"
                                            Background="{Binding Studio.AlphaTrackBrush}"/>
                                    <Slider Classes="overlay" Minimum="0" Maximum="100" Value="{Binding Studio.Alpha}"
                                            Background="Transparent"/>
                                </Grid>
                            </StackPanel>

                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- One clear action for the panel. -->
                <Border Grid.Row="2" Padding="18,10,18,12"
                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
                    <Button Classes="cta" Command="{Binding Studio.AddCurrentColorCommand}"
                            ToolTip.Tip="Add this color to the palette (undoable)">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Add" Width="16" Height="16"/>
                            <TextBlock Text="Add to Palette" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

            </Grid>
        </Border>

        <!-- ═══════════════════ CENTRE · toolbar + board ═══════════════════ -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*">

            <Border Grid.Row="0" Classes="panel" Padding="12,8" Margin="0,0,0,10">
                <Grid ColumnDefinitions="*,Auto">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Harmony rule -->
                        <ComboBox MinWidth="132" Height="34" Margin="0,0,4,0"
                                  ItemsSource="{Binding Studio.HarmonyTypes}"
                                  SelectedItem="{Binding Studio.SelectedHarmony}"
                                  ToolTip.Tip="Rule Generate/Space uses for unlocked colors">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static converters:EnumSpacedConverter.Instance}}"
                                               FontSize="12"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Generate: the main action of the app, always visible even
                             when the dock is collapsed (Ctrl+I). -->
                        <Button Height="34" Margin="0,0,8,0" FontWeight="SemiBold"
                                Command="{Binding Studio.GeneratePaletteCommand}"
                                ToolTip.Tip="Regenerate every unlocked color using the rule on the left (Space)">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Shuffle" Width="15" Height="15"/>
                                <TextBlock Text="Generate" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"
                                Background="{DynamicResource OutlineBrush}"/>

                        <!-- Extract a palette from an image -->
                        <Button Height="34" Margin="0,0,4,0"
                                Command="{Binding Studio.ExtractFromImageCommand}"
                                ToolTip.Tip="Pull the dominant colors out of an image">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="TrayArrowUp" Width="15" Height="15"/>
                                <TextBlock Text="From image" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Pickers (screen / image pixel) -->
                        <Button Height="34" Margin="0,0,4,0"
                                ToolTip.Tip="Eyedroppers — screen or a pixel of an image">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Eyedropper" Width="15" Height="15"/>
                                <TextBlock Text="Pick" VerticalAlignment="Center"/>
                                <materialIcons:MaterialIcon Kind="ChevronDown" Width="13" Height="13"/>
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuItem Header="Pick from screen"
                                              Command="{Binding Studio.PickFromScreenCommand}"/>
                                    <MenuItem Header="Pick from image pixel"
                                              Command="{Binding Studio.PickFromImageCommand}"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Gradient composer -->
                        <Button Height="34" Margin="0,0,4,0"
                                Command="{Binding Studio.OpenGradientStudioCommand}"
                                ToolTip.Tip="Build a multi-stop gradient from your colors — copy CSS, save SVG/PNG, or add its stops to the palette">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="GradientHorizontal" Width="15" Height="15"/>
                                <TextBlock Text="Gradient" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Board layout + destructive cleanup live one level down -->
                        <Button Classes="iconChip" Height="34" Width="34"
                                ToolTip.Tip="More board actions">
                            <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="16" Height="16"/>
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuItem Header="Row layout"
                                              Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:ViewMode.Row}"/>
                                    <MenuItem Header="Grid layout"
                                              Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:ViewMode.Grid}"/>
                                    <MenuItem Header="List layout"
                                              Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:ViewMode.List}"/>
                                    <MenuItem Header="Compact layout"
                                              Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:ViewMode.Compact}"/>
                                    <Separator/>
                                    <MenuItem Header="Add base color"
                                              Command="{Binding Studio.AddCurrentColorCommand}"/>
                                    <MenuItem Header="Clear palette"
                                              Command="{Binding ClearPaletteCommand}"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                    </WrapPanel>

                    <local:ToolbarGlobalsView Grid.Column="1"/>
                </Grid>
            </Border>

            <local:PaletteBoardView Grid.Row="1"/>

        </Grid>

    </Grid>
</UserControl>
