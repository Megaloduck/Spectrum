<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Spectrum.ViewModels"
        xmlns:models="using:Spectrum.Models"
        xmlns:converters="using:Spectrum.Converters"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        xmlns:workspaces="using:Spectrum.Views.Workspaces"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="820"
        x:Class="Spectrum.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Spectrum.ico"
        Title="Spectrum"
        Width="1500" Height="800"
        MinWidth="1240" MinHeight="680"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- The shell is three things: the app bar, the palette library, and the
         active workspace. Everything task-specific lives in Views/Workspaces. -->
    <Grid x:Name="RootGrid" RowDefinitions="Auto,*" Margin="22">

        <!-- ═══════════════════ APP BAR · brand · workspaces · actions ═══════════════════ -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">

            <!-- Brand: gradient palette mark, wordmark, open palette + size -->
            <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                <Border Width="37" Height="37" CornerRadius="11"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                    <materialIcons:MaterialIcon Kind="Palette" Width="21" Height="21"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon.Foreground>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#5B8DEF" Offset="0"/>
                                <GradientStop Color="#58C27D" Offset="0.28"/>
                                <GradientStop Color="#F4C95D" Offset="0.52"/>
                                <GradientStop Color="#F2994A" Offset="0.76"/>
                                <GradientStop Color="#EB5757" Offset="1"/>
                            </LinearGradientBrush>
                        </materialIcons:MaterialIcon.Foreground>
                    </materialIcons:MaterialIcon>
                </Border>

                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="Spectrum" Classes="display" FontSize="24"/>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="{Binding Library.SelectedPalette.Name}"
                                   Classes="value" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                        <TextBlock Text="—" Classes="caption"/>
                        <TextBlock Text="{Binding PaletteCountLabel}" Classes="caption mono"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Workspace segments: each one shows only the panels its task needs -->
            <Border Grid.Column="1" Padding="3"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="999"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    ToolTip.Tip="Switch workspace — Ctrl+1 Studio · Ctrl+2 Preview · Ctrl+3 Analyze · Ctrl+4 Export">
                <StackPanel Orientation="Horizontal" Spacing="1">
                    <Button Classes="wsTab" Classes.active="{Binding IsStudioMode}" Content="Studio"
                            Command="{Binding SetWorkspaceCommand}"
                            CommandParameter="{x:Static models:WorkspaceMode.Studio}"/>
                    <Button Classes="wsTab" Classes.active="{Binding IsPreviewMode}" Content="Preview"
                            Command="{Binding SetWorkspaceCommand}"
                            CommandParameter="{x:Static models:WorkspaceMode.Preview}"/>
                    <Button Classes="wsTab" Classes.active="{Binding IsAnalyzeMode}" Content="Analyze"
                            Command="{Binding SetWorkspaceCommand}"
                            CommandParameter="{x:Static models:WorkspaceMode.Analyze}"/>
                    <Button Classes="wsTab" Classes.active="{Binding IsExportMode}" Content="Export"
                            Command="{Binding SetWorkspaceCommand}"
                            CommandParameter="{x:Static models:WorkspaceMode.Export}"/>
                </StackPanel>
            </Border>

            <!-- Quick actions: panels · history · appearance -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Classes="iconChip ghost" Command="{Binding ToggleLibraryPanelCommand}"
                        ToolTip.Tip="Show / hide the palette library (Ctrl+B)">
                    <materialIcons:MaterialIcon Kind="PageLayoutSidebarLeft" Width="17" Height="17"/>
                </Button>
                <Button Classes="iconChip ghost" Command="{Binding ToggleInspectorCommand}"
                        ToolTip.Tip="Show / hide the workspace dock (Ctrl+I)">
                    <materialIcons:MaterialIcon Kind="DockRight" Width="17" Height="17"/>
                </Button>

                <Border Width="1" Height="20" Margin="5,0"
                        Background="{DynamicResource OutlineBrush}"/>

                <Button Classes="iconChip ghost" Command="{Binding UndoCommand}"
                        ToolTip.Tip="Undo (Ctrl+Z)">
                    <materialIcons:MaterialIcon Kind="Undo" Width="17" Height="17"/>
                </Button>
                <Button Classes="iconChip ghost" Command="{Binding RedoCommand}"
                        ToolTip.Tip="Redo (Ctrl+Y)">
                    <materialIcons:MaterialIcon Kind="Redo" Width="17" Height="17"/>
                </Button>

                <Border Width="1" Height="20" Margin="5,0"
                        Background="{DynamicResource OutlineBrush}"/>

                <Button Classes="iconChip ghost" Command="{Binding ToggleThemeCommand}"
                        ToolTip.Tip="Toggle light / dark">
                    <materialIcons:MaterialIcon Kind="WhiteBalanceSunny" Width="17" Height="17"/>
                </Button>
                <Button Classes="iconChip ghost" Command="{Binding OpenSettingsCommand}"
                        ToolTip.Tip="Settings (Ctrl+,)">
                    <materialIcons:MaterialIcon Kind="CogOutline" Width="17" Height="17"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════ BODY · library · workspace ═══════════════════
             Columns are separated by a GridSplitter so the library is
             resizable; each workspace owns its own toolbar, board and dock. -->
        <Grid Grid.Row="1" x:Name="BodyGrid" ColumnDefinitions="250,12,*">

            <GridSplitter Grid.Column="1" x:Name="LibrarySplitter" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" Width="12" IsVisible="{Binding LibraryVisible}"
                          ToolTip.Tip="Drag to resize the library"/>

            <!-- ============ PALETTE LIBRARY SIDEBAR ============ -->
            <Border Grid.Column="0" x:Name="LibraryPanel" Classes="panel" Padding="12"
                    IsVisible="{Binding LibraryVisible}">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Text="LIBRARY" Classes="eyebrow" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <Button Grid.Column="1" Classes="iconChip ghost" Width="28" Height="28"
                                Command="{Binding Library.NewPaletteCommand}"
                                ToolTip.Tip="New palette (Ctrl+N)">
                            <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                        </Button>
                        <Button Grid.Column="2" Classes="iconChip ghost" Width="28" Height="28"
                                Command="{Binding ToggleLibraryPanelCommand}"
                                ToolTip.Tip="Collapse the library panel (Ctrl+B)">
                            <materialIcons:MaterialIcon Kind="ChevronLeft" Width="16" Height="16"/>
                        </Button>
                    </Grid>

                    <TextBox Grid.Row="1" Text="{Binding Library.SearchText}" Watermark="Search palettes…"
                             Margin="0,10,0,0" FontSize="12" Padding="9,6"/>

                    <ComboBox Grid.Row="2" ItemsSource="{Binding Library.Filters}"
                              SelectedItem="{Binding Library.SelectedFilter}"
                              Margin="0,6,0,0" Height="30" Padding="9,4" FontSize="11.5"
                              HorizontalAlignment="Stretch"
                              ToolTip.Tip="All / Pinned / Recent palettes">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static converters:EnumSpacedConverter.Instance}}"
                                           FontSize="11.5"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ListBox Grid.Row="3" ItemsSource="{Binding Library.VisiblePalettes}"
                             SelectedItem="{Binding Library.SelectedPalette}"
                             Classes="paletteList"
                             Background="Transparent" Margin="0,8,0,0"
                             AutoScrollToSelectedItem="True"
                             x:Name="PaletteList">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PaletteItemViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="7,6"
                                      Background="Transparent"
                                      PointerPressed="OnPaletteItemPointerPressed"
                                      x:Name="Row">
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6"
                                            Background="{Binding PreviewBrush}"
                                            BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                                            AutomationProperties.Name="{Binding Name} palette preview"
                                            ToolTip.Tip="Palette preview"/>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2"
                                                PointerPressed="OnPaletteNamePointerPressed">
                                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Classes="swatchName"
                                                 IsVisible="{Binding IsRenaming}"
                                                 x:Name="NameEditor"
                                                 Padding="0,4"
                                                 FontWeight="SemiBold" FontSize="12.5"
                                                 LostFocus="OnNameEditorLostFocus"
                                                 KeyDown="OnNameEditorKeyDown"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   x:Name="NameText"
                                                   Cursor="Hand"/>
                                        <TextBlock Text="{Binding CountLabel}" Classes="caption mono" FontSize="10.5"/>
                                    </StackPanel>

                                    <!-- Pin stays readable at rest; rename/delete fade in on hover -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1"
                                                VerticalAlignment="Center">
                                        <ToggleButton Classes="iconOnly" Padding="4"
                                                      IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                                      ToolTip.Tip="Pin this palette (stays at the top)">
                                            <materialIcons:MaterialIcon Kind="PinOutline" Width="13" Height="13"/>
                                        </ToggleButton>

                                        <Button Classes="iconOnly paletteRail"
                                                Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).Library.RenamePaletteCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Rename this palette">
                                            <materialIcons:MaterialIcon Kind="Pencil" Width="13" Height="13"/>
                                        </Button>

                                        <Button Classes="iconOnly paletteRail"
                                                Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).Library.DeletePaletteCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Delete this palette">
                                            <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="13" Height="13"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Save state + library menu -->
                    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="2,8,0,0">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center">
                            <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{DynamicResource SuccessBrush}"/>
                            <TextBlock Text="{Binding Library.SaveStateLabel}" Classes="caption" FontSize="10.5"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="Autosaved locally — no cloud, no account"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="iconChip ghost" Width="28" Height="28"
                                ToolTip.Tip="Library options (versions, import/export)">
                            <materialIcons:MaterialIcon Kind="DotsVertical" Width="16" Height="16"/>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel x:DataType="vm:MainWindowViewModel" Width="260" Spacing="8" Margin="4">
                                        <TextBlock Text="PALETTE VERSIONS" Classes="eyebrow"/>
                                        <TextBlock Text="{Binding Library.SelectedPalette.VersionsLabel}"
                                                   Classes="caption"
                                                   IsVisible="{Binding Library.SelectedPalette, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        <ItemsControl ItemsSource="{Binding Library.SelectedPalette.Dto.Versions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:PaletteVersionDto">
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                                        <TextBlock FontSize="12" VerticalAlignment="Center"
                                                                   Text="{Binding SavedUtc, Converter={x:Static converters:VersionTimeConverter.Instance}}"/>
                                                        <Button Grid.Column="1" Classes="ghost small"
                                                                Command="{Binding $parent[ItemsControl].((vm:PaletteLibraryViewModel)DataContext).RestoreVersionCommand}"
                                                                CommandParameter="{Binding}">Restore</Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Separator/>
                                        <TextBlock Text="FILES" Classes="eyebrow"/>
                                        <Button Classes="iconOnly" Command="{Binding Library.ImportPaletteFileCommand}"
                                                ToolTip.Tip="Import a palette file (CSS / GPL / ASE / ACO)">
                                            <materialIcons:MaterialIcon Kind="Upload" Width="18" Height="18"/>
                                        </Button>
                                        <Button Classes="iconOnly" Command="{Binding Library.ExportLibraryCommand}"
                                                ToolTip.Tip="Export the whole library">
                                            <materialIcons:MaterialIcon Kind="CloudDownloadOutline" Width="18" Height="18"/>
                                        </Button>
                                        <Button Classes="iconOnly" Command="{Binding Library.ImportLibraryCommand}"
                                                ToolTip.Tip="Import a library from a file">
                                            <materialIcons:MaterialIcon Kind="FolderUploadOutline" Width="18" Height="18"/>
                                        </Button>
                                        <Separator/>
                                        <Button Classes="iconOnly" Command="{Binding Library.UndoLastDeleteCommand}"
                                                ToolTip.Tip="Undo last deleted palette"
                                                IsEnabled="{Binding Library.UndoLastDeleteCanExecute}">
                                            <materialIcons:MaterialIcon Kind="Undo" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                </Grid>
            </Border>

            <!-- ============ WORKSPACES ============
                 Only the active one is on screen; each brings its own toolbar,
                 content and dock instead of the shell swapping panels around. -->
            <Grid Grid.Column="2">
                <workspaces:StudioWorkspace IsVisible="{Binding IsStudioMode}"/>
                <workspaces:PreviewWorkspace IsVisible="{Binding IsPreviewMode}"/>
                <workspaces:AnalyzeWorkspace IsVisible="{Binding IsAnalyzeMode}"/>
                <workspaces:ExportWorkspace IsVisible="{Binding IsExportMode}"/>
            </Grid>

        </Grid>

        <!-- Toast: short-lived feedback for the latest action. Destructive actions
             (remove swatch, clear palette) add an Undo button and stay a bit longer.
             Declared last so it draws above everything else. -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,26" Padding="16,10" CornerRadius="12"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                BoxShadow="0 10 30 0 #40000000"
                IsVisible="{Binding IsToastVisible}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding ToastMessage}" VerticalAlignment="Center"
                           MaxWidth="520" TextTrimming="CharacterEllipsis"/>
                <Button Classes="ghost small"
                        Command="{Binding UndoCommand}"
                        IsVisible="{Binding ToastCanUndo}"
                        ToolTip.Tip="Undo (Ctrl+Z)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <materialIcons:MaterialIcon Kind="Undo" Width="14" Height="14"/>
                        <TextBlock Text="Undo" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

    </Grid>

</Window>
