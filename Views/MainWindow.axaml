<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Spectrum.ViewModels"
        xmlns:models="using:Spectrum.Models"
        xmlns:converters="using:Spectrum.Converters"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="700"
        x:Class="Spectrum.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Spectrum.ico"
        Title="Spectrum"
        Width="1200" Height="675"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" Margin="24">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,20">
            <TextBlock Text="Color Palette" Classes="h1"/>
            <TextBlock Text="Build, Generate and Export beautiful palettes" Classes="subtitle"/>
        </StackPanel>

        <!-- Body: color panel docked left, tools + board on the right -->
        <Grid Grid.Row="1" ColumnDefinitions="300,20,*">

            <!-- ============ COLOR PANEL ============ -->
            <Border Grid.Column="0" Classes="panel">
                 <Grid RowDefinitions="*,Auto">
                    <ScrollViewer>
                         <StackPanel Spacing="12"  Margin="20" >

                        <TextBlock Text="COLOR PANEL" Classes="eyebrow"/>

                        <!-- Base color swatch with its auto-name overlaid, bottom-left -->
                        <Border Background="{Binding BaseColorBrush}" Height="150" CornerRadius="14"
                                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1.3">
                            <TextBlock Text="{Binding BaseColorName}" Foreground="{Binding BaseForegroundBrush}"
                                       FontWeight="Bold" FontSize="14"
                                       Margin="14" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                        </Border>

                        <Grid ColumnDefinitions="88,*">
                            <ComboBox Grid.Column="0" SelectedIndex="0" Margin="0,0,8,0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="HEX"/>
                            </ComboBox>
                            <TextBox Grid.Column="1" Text="{Binding BaseHex}" Classes="mono" Watermark="#RRGGBB"/>
                        </Grid>

                        <Button Content="Add to Palette" Command="{Binding AddCurrentColorCommand}"
                                HorizontalAlignment="Stretch"/>


                                 <!-- Color Generator Slider -->
                            <StackPanel         >

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Hue" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Hue, StringFormat=N0}" Classes="caption"/>    
                                </Grid>
                                <Grid Height="40">

        <!-- Actual gradient bar -->
        <Border Height="8"
                VerticalAlignment="Center"
                CornerRadius="4"
                Background="{Binding HueTrackBrush}"/>

        <!-- Interactive slider -->
        <Slider Minimum="0"
                Maximum="360"   
                Value="{Binding Hue}"
                Background="Transparent"/>

    </Grid>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                    <TextBlock Text="Saturation" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Saturation, StringFormat=N0}" Classes="caption"/>
                                </Grid>
                                <Grid Height="40">

        <Border Height="8"
                VerticalAlignment="Center"
                CornerRadius="4"
                Background="{Binding SaturationTrackBrush}"/>

        <Slider Minimum="0"
                Maximum="100"
                Value="{Binding Saturation}"
                Background="Transparent"/>

    </Grid>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                    <TextBlock Text="Brightness" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Lightness, StringFormat=N0}" Classes="caption"/>
                                </Grid>
                                <Grid Height="40">

        <Border Height="8"
                VerticalAlignment="Center"
                CornerRadius="4"
                Background="{Binding BrightnessTrackBrush}"/>

        <Slider Minimum="0"
                Maximum="100"
                Value="{Binding Lightness}"
                Background="Transparent"/>

    </Grid>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                    <TextBlock Text="Temperature" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Temperature, StringFormat=N0}" Classes="caption"/>
                                </Grid>
                                <Grid Height="40">

        <Border Height="8"
                VerticalAlignment="Center"
                CornerRadius="4"
                Background="{Binding TemperatureTrackBrush}"/>

        <Slider Minimum="-100"
                Maximum="100"
                Value="{Binding Temperature}"
                Background="Transparent"/>

    </Grid>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                    <TextBlock Text="Opacity" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AlphaLabel}" Classes="caption"/>
                                </Grid>
                                <Grid Height="40">

        <Border Height="8"
                VerticalAlignment="Center"
                CornerRadius="4"
                Background="{Binding AlphaTrackBrush}"/>

        <Slider Minimum="0"
                Maximum="100"
                Value="{Binding Alpha}"
                Background="Transparent"/>

    </Grid>

                            </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                     <!-- Harmonize Button -->
                     <StackPanel Grid.Row="1" Margin="20,10"  Spacing="10">
                         <Separator VerticalAlignment="Center"/>
                         <Button Content="Press Space to Harmonize" Command="{Binding GeneratePaletteCommand}"
                                HorizontalAlignment="Stretch" ToolTip.Tip="Regenerates every unlocked color — using the Harmonize tool if one is selected"/>
                     </StackPanel>
                     
                </Grid>
            </Border>

            <!-- ============ TOOLS + palette board ============ -->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*,Auto">

                <TextBlock Grid.Row="0" Text="TOOLS" Classes="eyebrow" Margin="2,0,0,10"/>

                <!-- Toolbar: contained in a single panel card with generation controls on the left,
     history and theme controls on the right, with thin dividers between groups -->
<Border Grid.Row="1" Classes="panel" Padding="16,12" Margin="0,0,0,14">
    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" VerticalAlignment="Center">

        <!-- Harmony Type ComboBox -->
        <ComboBox Grid.Column="0" MinWidth="150" Height="38"
                  ItemsSource="{Binding HarmonyTypes}" SelectedItem="{Binding SelectedHarmony}"
                  ToolTip.Tip="Rule Generate/Space uses for unlocked colors">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={x:Static converters:EnumSpacedConverter.Instance}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Color Blind Mode ComboBox -->
        <ComboBox Grid.Column="1" MinWidth="150" Height="38" Margin="8,0,0,0"
                  ItemsSource="{Binding ColorBlindModes}" SelectedItem="{Binding SelectedColorBlindMode}"
                  ToolTip.Tip="Preview the board as someone with this color vision would see it">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={x:Static converters:EnumSpacedConverter.Instance}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Divider 1 -->
        <Border Grid.Column="2" Width="1" Height="24" Margin="16,0"
                Background="{DynamicResource OutlineBrush}" Opacity="0.5"/>

        <!-- Extract from Image Button -->
        <Button Grid.Column="3" Height="38" Command="{Binding ExtractFromImageCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="TrayArrowUp" Width="16" Height="16"/>
                <TextBlock Text="Extract from Image" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- Flexible Spacer -->
        <Grid Grid.Column="4"/>

        <!-- Palette Count + Clear Button -->
        <Grid Grid.Column="5" ColumnDefinitions="Auto,Auto" Margin="0,0,12,0">
            <TextBlock Grid.Column="0" Text="{Binding PaletteCountLabel}" Classes="caption"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Grid.Column="1" Classes="ghost" Command="{Binding ClearPaletteCommand}"
                    ToolTip.Tip="Remove every swatch" Padding="8,4" Height="38">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15"/>
                    <TextBlock Text="Clear" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Divider 2 -->
        <Border Grid.Column="6" Width="1" Height="24" Margin="16,0"
                Background="{DynamicResource OutlineBrush}" Opacity="0.5"/>

        <!-- Undo Button -->
        <Button Grid.Column="7" Classes="iconOnly" Width="38" Height="38" Margin="12,0,0,0"
                Command="{Binding UndoCommand}" ToolTip.Tip="Undo">
            <materialIcons:MaterialIcon Kind="Undo" Width="16" Height="16"/>
        </Button>

        <!-- Redo Button -->
        <Button Grid.Column="8" Classes="iconOnly" Width="38" Height="38" Margin="4,0,0,0"
                Command="{Binding RedoCommand}" ToolTip.Tip="Redo">
            <materialIcons:MaterialIcon Kind="Redo" Width="16" Height="16"/>
        </Button>

        <!-- Theme Toggle Button -->
        <Button Grid.Column="9" Classes="iconOnly" Width="38" Height="38" Margin="4,0,0,0"
                Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Toggle light / dark">
            <materialIcons:MaterialIcon Kind="WhiteBalanceSunny" Width="16" Height="16"/>
        </Button>

        <!-- Divider 3 -->
        <Border Grid.Column="10" Width="1" Height="24" Margin="16,0"
                Background="{DynamicResource OutlineBrush}" Opacity="0.5"/>

        <!-- Save Palette Button -->
        <Button Grid.Column="11" Classes="iconOnly" Width="38" Height="38" Margin="12,0,0,0"
                Command="{Binding SavePaletteCommand}" ToolTip.Tip="Save palette to a file">
            <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="16" Height="16"/>
        </Button>

        <!-- Load Palette Button -->
        <Button Grid.Column="12" Classes="iconOnly" Width="38" Height="38" Margin="4,0,0,0"
                Command="{Binding LoadPaletteCommand}" ToolTip.Tip="Load palette from a file">
            <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16"/>
        </Button>

    </Grid>
</Border>   

                <!-- THE PALETTE -->
                <Border Grid.Row="3" Classes="panel" Padding="14">
                    <ItemsControl ItemsSource="{Binding Palette}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ColorSwatch">
                                <Border Background="{Binding Brush}" CornerRadius="14" Margin="4" Cursor="Hand"
                                        PointerPressed="OnSwatchPointerPressed"
                                        PointerMoved="OnSwatchPointerMoved"
                                        PointerReleased="OnSwatchPointerReleased"
                                        ToolTip.Tip="Drag to reorder">
                                    <Grid RowDefinitions="Auto,*,Auto" Margin="14">

                                        <!-- Icon stack: lock, reorder, rename, copy, remove -->
                                        <StackPanel Grid.Row="0" HorizontalAlignment="Right" Spacing="6">
                                            <ToggleButton Classes="iconOnly"
                                                          IsChecked="{Binding IsLocked, Mode=TwoWay}"   
                                                          ToolTip.Tip="Keep this color when generating">
                                                <materialIcons:MaterialIcon
                                                    Kind="{Binding IsLocked, Converter={x:Static converters:LockIconConverter.Instance}}"
                                                    Width="14" Height="14" Foreground="{Binding ForegroundBrush}"/>
                                            </ToggleButton>
                                            <Button Classes="iconOnly" Foreground="{Binding ForegroundBrush}"
                                                    Command="{Binding MoveUpCommand}" CommandParameter="{Binding}">
                                                <materialIcons:MaterialIcon Kind="ArrowUp" Width="14" Height="14" Foreground="{Binding ForegroundBrush}"/>
                                            </Button>
                                            <Button Classes="iconOnly" Foreground="{Binding ForegroundBrush}"
                                                    Command="{Binding MoveDownCommand}" CommandParameter="{Binding}">
                                                <materialIcons:MaterialIcon Kind="ArrowDown" Width="14" Height="14" Foreground="{Binding ForegroundBrush}"/>
                                            </Button>
                                            <Button Classes="iconOnly" Foreground="{Binding ForegroundBrush}">
                                                <materialIcons:MaterialIcon Kind="Pencil" Width="14" Height="14" Foreground="{Binding ForegroundBrush}"/>
                                                <Button.Flyout>
                                                    <Flyout>
                                                        <StackPanel x:DataType="models:ColorSwatch" Width="180" Spacing="8" Margin="4">
                                                            <TextBlock Text="RENAME" Classes="eyebrow"/>
                                                            <TextBox Text="{Binding Name}" Watermark="Name"/>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                            <Button Classes="iconOnly" Foreground="{Binding ForegroundBrush}"
                                                    Command="{Binding CopyCommand}" CommandParameter="{Binding}">
                                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" Foreground="{Binding ForegroundBrush}"/>
                                            </Button>
                                            <Button Classes="iconOnly" Foreground="{Binding ForegroundBrush}"
                                                    Command="{Binding RemoveCommand}" CommandParameter="{Binding}">
                                                <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{Binding ForegroundBrush}"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- Name + hex label anchored to the bottom of the bar -->
                                        <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                                       TextWrapping="Wrap" Foreground="{Binding ForegroundBrush}"/>
                                            <TextBlock Text="HEX" FontSize="10" Opacity="0.75" Foreground="{Binding ForegroundBrush}"/>
                                            <TextBlock Text="{Binding Hex}" FontWeight="SemiBold" FontSize="14"
                                                       Classes="mono" Foreground="{Binding ForegroundBrush}"/>
                                            <TextBlock Text="{Binding ContrastLabel}" FontSize="10" Opacity="0.75"
                                                       Foreground="{Binding ForegroundBrush}"
                                                       ToolTip.Tip="WCAG contrast of this card's own text against its background"/>
                                        </StackPanel>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Footer -->
                <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,16,0,0">

                    <Button Grid.Column="0" Classes="ghost" Command="{Binding CopyAllHexCommand}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="ContentCopy" Width="15" Height="15"/>
                            <TextBlock Text="Copy All as Text" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Classes="caption" VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="2" ItemsSource="{Binding ExportFormats}" SelectedItem="{Binding SelectedExportFormat}"
                              Margin="0,0,8,0" Height="38">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static converters:EnumSpacedConverter.Instance}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="3" Content="Export Palette">
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel x:DataType="vm:MainWindowViewModel" Width="260" Spacing="10" Margin="4">
                                    <TextBlock Text="EXPORT" Classes="eyebrow"/>
                                    <Button Content="Build Preview" Command="{Binding BuildExportPreviewCommand}"
                                            HorizontalAlignment="Stretch"/>
                                    <TextBox Text="{Binding ExportPreview}" AcceptsReturn="True" IsReadOnly="True"
                                             Height="120" TextWrapping="Wrap" Classes="mono"/>
                                    <Button Content="Copy Export" Command="{Binding CopyExportCommand}"
                                            HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                </Grid>

            </Grid>

        </Grid>

    </Grid>

</Window>
