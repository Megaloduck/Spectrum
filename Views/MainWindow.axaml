<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Spectrum.ViewModels"
        xmlns:models="using:Spectrum.Models"
        xmlns:converters="using:Spectrum.Converters"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        xmlns:workspaces="using:Spectrum.Views.Workspaces"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="820"
        x:Class="Spectrum.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Spectrum.ico"
        Title="Spectrum"
        Width="1500" Height="800"
        MinWidth="1240" MinHeight="680"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- The shell is three things: the app bar, the palette rail, and the
         active workspace. Everything task-specific lives in Views/Workspaces. -->
    <Grid x:Name="RootGrid" RowDefinitions="Auto,*" Margin="0,10,10,10">

        <!-- ═══════════════════ APP BAR · brand · workspaces · actions ═══════════════════ -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">

            <!-- Brand: gradient palette mark, wordmark, open palette + size -->
            <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center" Margin="10,0,0,0">
                <Border Width="37" Height="37" CornerRadius="11"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                    <materialIcons:MaterialIcon Kind="Palette" Width="21" Height="21"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon.Foreground>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#5B8DEF" Offset="0"/>
                                <GradientStop Color="#58C27D" Offset="0.28"/>
                                <GradientStop Color="#F4C95D" Offset="0.52"/>
                                <GradientStop Color="#F2994A" Offset="0.76"/>
                                <GradientStop Color="#EB5757" Offset="1"/>
                            </LinearGradientBrush>
                        </materialIcons:MaterialIcon.Foreground>
                    </materialIcons:MaterialIcon>
                </Border>

                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="Spectrum" Classes="display" FontSize="24"/>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="{Binding Library.SelectedPalette.Name}"
                                   Classes="value" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                        <TextBlock Text="—" Classes="caption"/>
                        <TextBlock Text="{Binding PaletteCountLabel}" Classes="caption mono"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Workspace segments: each one shows only the panels its task needs -->
            <Border Grid.Column="1" Padding="3"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="999"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    ToolTip.Tip="Switch workspace — Ctrl+1 Studio · Ctrl+2 Preview · Ctrl+3 Analyze · Ctrl+4 Export">
                <StackPanel Orientation="Horizontal" Spacing="1">
                    <Button Classes="wsTab" Classes.active="{Binding IsStudioMode}" Content="Studio"
                            Command="{Binding SetWorkspaceCommand}"
                            CommandParameter="{x:Static models:WorkspaceMode.Studio}"/>
                    <Button Classes="wsTab" Classes.active="{Binding IsPreviewMode}" Content="Preview"
                            Command="{Binding SetWorkspaceCommand}"
                            CommandParameter="{x:Static models:WorkspaceMode.Preview}"/>
                    <Button Classes="wsTab" Classes.active="{Binding IsAnalyzeMode}" Content="Analyze"
                            Command="{Binding SetWorkspaceCommand}"
                            CommandParameter="{x:Static models:WorkspaceMode.Analyze}"/>
                    <Button Classes="wsTab" Classes.active="{Binding IsExportMode}" Content="Export"
                            Command="{Binding SetWorkspaceCommand}"
                            CommandParameter="{x:Static models:WorkspaceMode.Export}"/>
                </StackPanel>
            </Border>

            <!-- Quick actions: panels · history · appearance -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Classes="iconChip ghost" Command="{Binding ToggleLibraryPanelCommand}"
                        ToolTip.Tip="Show / hide the palette rail (Ctrl+B)">
                    <materialIcons:MaterialIcon Kind="PageLayoutSidebarLeft" Width="17" Height="17"/>
                </Button>
                <Button Classes="iconChip ghost" Command="{Binding ToggleInspectorCommand}"
                        ToolTip.Tip="Show / hide the workspace dock (Ctrl+I)">
                    <materialIcons:MaterialIcon Kind="DockRight" Width="17" Height="17"/>
                </Button>

                <Border Width="1" Height="20" Margin="5,0"
                        Background="{DynamicResource OutlineBrush}"/>

                <Button Classes="iconChip ghost" Command="{Binding UndoCommand}"
                        ToolTip.Tip="Undo (Ctrl+Z)">
                    <materialIcons:MaterialIcon Kind="Undo" Width="17" Height="17"/>
                </Button>
                <Button Classes="iconChip ghost" Command="{Binding RedoCommand}"
                        ToolTip.Tip="Redo (Ctrl+Y)">
                    <materialIcons:MaterialIcon Kind="Redo" Width="17" Height="17"/>
                </Button>

                <Border Width="1" Height="20" Margin="5,0"
                        Background="{DynamicResource OutlineBrush}"/>

                <Button Classes="iconChip ghost" Command="{Binding ToggleThemeCommand}"
                        ToolTip.Tip="Toggle light / dark">
                    <materialIcons:MaterialIcon Kind="WhiteBalanceSunny" Width="17" Height="17"/>
                </Button>
                <Button Classes="iconChip ghost" Command="{Binding OpenSettingsCommand}"
                        ToolTip.Tip="Settings (Ctrl+,)">
                    <materialIcons:MaterialIcon Kind="CogOutline" Width="17" Height="17"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════ BODY · palette rail · workspace ═══════════════════ -->
        <Grid Grid.Row="1" x:Name="BodyGrid" ColumnDefinitions="68,10,*">

            <!-- ============ PALETTE RAIL ============
                 Discord-style navigation: one thumbnail per palette, a selection
                 pill on the left, management on right-click, and utility actions
                 pinned to the bottom. -->
            <Grid Grid.Column="0" x:Name="LibraryPanel" IsVisible="{Binding LibraryVisible}"
                  RowDefinitions="*,Auto">

                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="PaletteList"
                             Classes="paletteRail"
                             ItemsSource="{Binding Library.VisiblePalettes}"
                             SelectedItem="{Binding Library.SelectedPalette}"
                             AutoScrollToSelectedItem="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PaletteItemViewModel">
                                <Grid ColumnDefinitions="4,44" Margin="0,3"
                                      Background="Transparent"
                                      PointerPressed="OnPaletteItemPointerPressed">

                                    <!-- Discord's selection pill: quiet until selected -->
                                    <Border Classes="railPill" Width="3" Height="20" CornerRadius="2"
                                            VerticalAlignment="Center" HorizontalAlignment="Left"
                                            Background="{DynamicResource TextPrimaryBrush}"/>

                                    <Grid x:Name="PaletteTile" Grid.Column="1"
                                          Width="44" Height="44" Background="Transparent">
                                        <ToolTip.Tip>
                                            <StackPanel x:DataType="vm:PaletteItemViewModel" Width="190" Spacing="3" Margin="4">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="{Binding CountLabel}" Classes="caption mono" FontSize="10.5"/>
                                                <TextBlock Text="{Binding UpdatedLabel}" Classes="caption" FontSize="10.5"/>
                                                <Separator/>
                                                <TextBlock Text="Click to open · right-click to manage"
                                                           Classes="caption" FontSize="10.5"/>
                                            </StackPanel>
                                        </ToolTip.Tip>

                                        <!-- The palette itself -->
                                        <Border Classes="railTileFace" CornerRadius="5"
                                                Background="{Binding PreviewBrush}"
                                                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"/>

                                        <!-- Empty palettes still read as a slot -->
                                        <materialIcons:MaterialIcon Kind="PaletteOutline" Width="17" Height="17"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    Opacity="0.4"
                                                                    IsVisible="{Binding PreviewBrush, Converter={x:Static ObjectConverters.IsNull}}"/>

                                        <!-- Pinned palettes float to the top; mark them -->
                                        <Border IsVisible="{Binding IsPinned}"
                                                Width="14" Height="14" CornerRadius="4" Margin="2"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BoxShadow="0 1 3 0 #30000000">
                                            <materialIcons:MaterialIcon Kind="Pin" Width="9" Height="9"
                                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Per-palette actions: rename, pin, duplicate, delete -->
                                        <Grid.ContextFlyout>
                                            <Flyout Placement="Right">
                                                <StackPanel x:DataType="vm:PaletteItemViewModel" Width="238"
                                                            Spacing="8" Margin="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                                        <Border Width="36" Height="36" CornerRadius="9"
                                                                Background="{Binding PreviewBrush}"
                                                                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"/>
                                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                                            <TextBlock Text="{Binding CountLabel}" Classes="caption mono" FontSize="10.5"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <TextBlock Text="NAME" Classes="eyebrow" Margin="0,4,0,0"/>
                                                    <TextBox x:Name="NameEditor"
                                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Watermark="Palette name"
                                                             LostFocus="OnNameEditorLostFocus"
                                                             KeyDown="OnNameEditorKeyDown"/>

                                                    <Separator/>

                                                    <Button Classes="menuItem" Command="{Binding TogglePinCommand}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <materialIcons:MaterialIcon Kind="Pin" Width="14" Height="14"/>
                                                            <TextBlock Text="Pin / unpin" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Classes="menuItem" Command="{Binding DuplicateCommand}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <materialIcons:MaterialIcon Kind="ContentDuplicate" Width="14" Height="14"/>
                                                            <TextBlock Text="Duplicate palette" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Classes="menuItem" Command="{Binding DeleteCommand}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14"
                                                                                        Foreground="{DynamicResource DangerBrush}"/>
                                                            <TextBlock Text="Delete palette" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource DangerBrush}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Flyout>
                                        </Grid.ContextFlyout>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- No matches (search/filter is in the library flyout) -->
                <TextBlock Grid.Row="0" Text="No palettes match"
                           Classes="caption" FontSize="10" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="6,18"
                           IsVisible="{Binding Library.IsLibraryEmpty}"
                           HorizontalAlignment="Center" VerticalAlignment="Top"/>

                <!-- Utility actions: new · manage/search · settings (hide lives in
                     the app bar and on Ctrl+B, so the rail stays three chips wide) -->
                <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,4"
                            HorizontalAlignment="Center">
                    <Border Width="34" Height="1" Margin="0,4,0,6"
                            Background="{DynamicResource HairlineBrush}"/>

                    <Button Classes="railAction" Command="{Binding Library.NewPaletteCommand}"
                            ToolTip.Tip="New palette (Ctrl+N)">
                        <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18"/>
                    </Button>

                    <Button Classes="railAction"
                            ToolTip.Tip="Search, versions, import / export">
                        <materialIcons:MaterialIcon Kind="Magnify" Width="17" Height="17"/>
                        <Button.Flyout>
                            <!-- Bottom-aligned so the panel grows *up* from the chip:
                                 anchored at the top it ran past the window edge. -->
                            <Flyout Placement="RightEdgeAlignedBottom"
                                    Opened="OnLibraryFlyoutOpened">
                                <!-- History can be long; the height is capped to the
                                     window in OnLibraryFlyoutOpened. -->
                                <ScrollViewer x:Name="LibraryFlyoutScroll" MaxHeight="560"
                                              Padding="0,0,4,6"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                <StackPanel x:DataType="vm:MainWindowViewModel" Width="272"
                                            Spacing="8" Margin="2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="LIBRARY" Classes="eyebrow" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Library.PaletteCountLabel}"
                                                   Classes="caption mono" FontSize="10"/>
                                    </Grid>

                                    <TextBox Text="{Binding Library.SearchText}"
                                             Watermark="Search palettes and colors…"/>

                                    <ComboBox ItemsSource="{Binding Library.Filters}"
                                              SelectedItem="{Binding Library.SelectedFilter}"
                                              HorizontalAlignment="Stretch"
                                              ToolTip.Tip="All / Pinned / Recent palettes">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={x:Static converters:EnumSpacedConverter.Instance}}"
                                                           FontSize="11.5"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="{Binding Library.SaveStateLabel}" Classes="caption" FontSize="10.5"/>

                                    <Separator/>
                                    <TextBlock Text="VERSIONS · SELECTED PALETTE" Classes="eyebrow"/>
                                    <TextBlock Text="{Binding Library.SelectedPalette.VersionsLabel}"
                                               Classes="caption" FontSize="10.5"
                                               IsVisible="{Binding Library.SelectedPalette, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    <ItemsControl ItemsSource="{Binding Library.SelectedPalette.RecentVersions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:PaletteVersionDto">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <TextBlock FontSize="11.5" VerticalAlignment="Center"
                                                               Text="{Binding SavedUtc, Converter={x:Static converters:VersionTimeConverter.Instance}}"/>
                                                    <Button Grid.Column="1" Classes="ghost small"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).Library.RestoreVersionCommand}"
                                                            CommandParameter="{Binding}">Restore</Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator/>
                                    <TextBlock Text="FILES" Classes="eyebrow"/>
                                    <Button Classes="menuItem" Command="{Binding Library.ImportPaletteFileCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <materialIcons:MaterialIcon Kind="Upload" Width="14" Height="14"/>
                                            <TextBlock Text="Import palette file…" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="menuItem" Command="{Binding Library.ExportLibraryCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <materialIcons:MaterialIcon Kind="CloudDownloadOutline" Width="14" Height="14"/>
                                            <TextBlock Text="Export whole library…" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="menuItem" Command="{Binding Library.ImportLibraryCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <materialIcons:MaterialIcon Kind="FolderUploadOutline" Width="14" Height="14"/>
                                            <TextBlock Text="Import library…" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="menuItem" Command="{Binding Library.UndoLastDeleteCommand}"
                                            IsEnabled="{Binding Library.UndoLastDeleteCanExecute}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <materialIcons:MaterialIcon Kind="Undo" Width="14" Height="14"/>
                                            <TextBlock Text="Undo last delete" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Classes="railAction" Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="Settings (Ctrl+,)">
                        <materialIcons:MaterialIcon Kind="CogOutline" Width="17" Height="17"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ WORKSPACES ============
                 Only the active one is on screen; each brings its own toolbar,
                 content and dock instead of the shell swapping panels around. -->
            <Grid Grid.Column="2">
                <workspaces:StudioWorkspace IsVisible="{Binding IsStudioMode}"/>
                <workspaces:PreviewWorkspace IsVisible="{Binding IsPreviewMode}"/>
                <workspaces:AnalyzeWorkspace IsVisible="{Binding IsAnalyzeMode}"/>
                <workspaces:ExportWorkspace IsVisible="{Binding IsExportMode}"/>
            </Grid>

        </Grid>

        <!-- Toast: short-lived feedback for the latest action. Destructive actions
             (remove swatch, clear palette) add an Undo button and stay a bit longer.
             Declared last so it draws above everything else. -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,26" Padding="16,10" CornerRadius="12"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                BoxShadow="0 10 30 0 #40000000"
                IsVisible="{Binding IsToastVisible}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding ToastMessage}" VerticalAlignment="Center"
                           MaxWidth="520" TextTrimming="CharacterEllipsis"/>
                <Button Classes="ghost small"
                        Command="{Binding UndoCommand}"
                        IsVisible="{Binding ToastCanUndo}"
                        ToolTip.Tip="Undo (Ctrl+Z)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <materialIcons:MaterialIcon Kind="Undo" Width="14" Height="14"/>
                        <TextBlock Text="Undo" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

    </Grid>

</Window>
