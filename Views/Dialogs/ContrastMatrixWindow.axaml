<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        x:Class="Spectrum.Views.ContrastMatrixWindow"
        x:CompileBindings="False"
        Title="Contrast matrix"
        Width="860" Height="620"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/Spectrum.ico"
        Background="{DynamicResource CanvasBrush}">

    <!-- §4/§8 — every text-on-background pair of the palette scored at a glance. -->

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">

        <StackPanel Spacing="2">
            <TextBlock Text="CONTRAST MATRIX" Classes="eyebrow"/>
            <TextBlock Classes="subtitle"
                       Text="Rows are backgrounds, columns are text. Each cell is the WCAG ratio for that pair — hover it for AAA/AA verdicts and APCA (§4)."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,10"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Panel>
                <Grid x:Name="MatrixGrid" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <TextBlock x:Name="EmptyHint"
                           Text="This palette has no colors yet — add some in Studio first."
                           Classes="caption" IsVisible="False"/>
            </Panel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="SummaryText" Classes="caption" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Both buttons used to be icon-only / empty; they now say what they do. -->
                <Button Padding="12,8" Click="OnCopyCsv"
                        ToolTip.Tip="Copy the whole matrix (ratios, dot-decimal) to the clipboard">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="Table" Width="16" Height="16"/>
                        <TextBlock Text="Copy CSV" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="primary" Padding="12,8" Click="OnClose" IsCancel="True"
                        ToolTip.Tip="Close (Esc)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16"/>
                        <TextBlock Text="Close" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
