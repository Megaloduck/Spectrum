<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Spectrum.ViewModels"
        xmlns:conv="using:Spectrum.Converters"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        x:Class="Spectrum.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="660" Height="700" MinHeight="400" MaxHeight="760"
        CanResize="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/Spectrum.ico">

    <Grid RowDefinitions="*,Auto">

        <!-- ═══════════════════════════════════════════════════════════════════
             Scrollable settings body
             ═══════════════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="22,22,22,8">
            <StackPanel Spacing="12">

                <TextBlock Text="SETTINGS" Classes="eyebrow"/>
                <TextBlock Text="Everything here is stored locally and applies immediately."
                           Classes="subtitle"/>

                <!-- Appearance -->
                <Border Classes="panel" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="APPEARANCE" Classes="eyebrow"/>

                        <TextBlock Text="Theme" Classes="caption"/>
                        <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Themes}"
                                  SelectedItem="{Binding Theme}"
                                  HorizontalAlignment="Stretch"/>

                        <TextBlock Text="Accent color" Classes="caption" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="iconOnly" Click="OnPickAccent"
                                    ToolTip.Tip="Pick the accent color">
                                <materialIcons:MaterialIcon Kind="Palette" Width="18" Height="18"/>
                            </Button>
                            <Button Classes="iconOnly" Click="OnResetAccent"
                                    ToolTip.Tip="Reset the accent to the default">
                                <materialIcons:MaterialIcon Kind="Undo" Width="18" Height="18"/>
                            </Button>
                            <Border Width="34" Height="30" CornerRadius="8" BorderThickness="1.3"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    Background="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{Binding AccentLabel}" Classes="caption"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Density" Classes="caption" Margin="0,4,0,0"/>
                        <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Densities}"
                                  SelectedItem="{Binding Density}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- Defaults -->
                <Border Classes="panel" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="COPY &amp; EXPORT DEFAULTS" Classes="eyebrow"/>

                        <TextBlock Text="Default color format on copy" Classes="caption"/>
                        <ComboBox ItemsSource="{Binding CopyFormats}"
                                  SelectedItem="{Binding DefaultCopyFormat}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static conv:EnumSpacedConverter.Instance}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Default export format" Classes="caption" Margin="0,4,0,0"/>
                        <ComboBox ItemsSource="{Binding ExportFormats}"
                                  SelectedItem="{Binding DefaultExportFormat}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static conv:EnumSpacedConverter.Instance}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Hotkey -->
                <Border Classes="panel" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="GLOBAL HOTKEY (SCREEN EYEDROPPER)" Classes="eyebrow"/>

                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <CheckBox Content="Ctrl"  IsChecked="{Binding HotkeyCtrl}"/>
                            <CheckBox Content="Alt"   IsChecked="{Binding HotkeyAlt}"/>
                            <CheckBox Content="Shift" IsChecked="{Binding HotkeyShift}"/>
                            <CheckBox Content="Win"   IsChecked="{Binding HotkeyMeta}"/>
                            <ComboBox MinWidth="90"
                                      ItemsSource="{x:Static vm:SettingsViewModel.HotkeyKeys}"
                                      SelectedItem="{Binding HotkeyKey}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding HotkeyPreview}"
                                   Classes="caption mono" FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Storage -->
                <Border Classes="panel" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="STORAGE" Classes="eyebrow"/>

                        <TextBlock Text="Storage location" Classes="caption"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0"
                                     IsReadOnly="True"
                                     Text="{Binding StorageLocationLabel}"
                                     Classes="mono" FontSize="12"/>
                            <Button Grid.Column="1" Classes="iconOnly"
                                    Click="OnBrowseStorage"
                                    ToolTip.Tip="Browse the storage folder">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline"
                                                            Width="18" Height="18"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="Storage location setting — autosave, backups and version history all live here."
                                   Classes="caption" FontSize="11" TextWrapping="Wrap"/>

                        <TextBlock Text="Provider" Classes="caption" Margin="0,4,0,0"/>
                        <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.StorageProviders}"
                                  SelectedItem="{Binding StorageProvider}"
                                  HorizontalAlignment="Stretch"
                                  ToolTip.Tip="json = flat file library · sqlite = local database (§9)"/>
                    </StackPanel>
                </Border>

                <!-- Danger zone -->
                <Border BorderThickness="1.3" BorderBrush="#E5484D"
                        CornerRadius="18" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="RESET / CLEAR DATA"
                                   Classes="eyebrow" Foreground="#E5484D"/>
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="Deletes every palette, version and backup from this app's storage folder. Settings are kept."/>
                        <Button x:Name="ResetButton"
                                Classes="iconOnly"
                                Click="OnResetData"
                                ToolTip.Tip="Destructive — deletes every palette, version and backup"
                                HorizontalAlignment="Left"
                                Foreground="#E5484D"
                                BorderBrush="#E5484D"/>
                    </StackPanel>
                </Border>

                <!-- About / updates -->
                <Border Classes="panel" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="ABOUT &amp; UPDATES" Classes="eyebrow"/>
                        <TextBlock x:Name="VersionText" Classes="caption mono" FontSize="11"/>
                        <TextBlock x:Name="UpdateStatus" Classes="caption" TextWrapping="Wrap"
                                   Text="Offline-first: Spectrum makes no network calls in the background."/>
                        <Button Classes="iconOnly"
                                Click="OnCheckUpdates"
                                ToolTip.Tip="Check for updates"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════════════════
             Sticky footer · Done button always visible
             ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="0,1,0,0"
                Padding="22,12">
            <Button Classes="primary iconOnly"
                    Click="OnDone"
                    ToolTip.Tip="Save and close settings"
                    HorizontalAlignment="Stretch"
                    FontWeight="SemiBold"/>
        </Border>

    </Grid>
</Window>